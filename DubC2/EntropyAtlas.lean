/-- `log x / log y ≤ c / d` from `x ^ d ≤ y ^ c`. -/
theorem log_div_log_le {x y : ℝ} {c d : ℕ} (hx : 0 < x) (hy : 1 < y) (hd : 0 < d)
    (h : x ^ d ≤ y ^ c) : Real.log x / Real.log y ≤ c / d := by
  have hly : 0 < Real.log y := Real.log_pos hy
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  rw [div_le_div_iff₀ hly hd']
  have := Real.log_le_log (pow_pos hx d) h
  rw [Real.log_pow, Real.log_pow] at this
  linarith

