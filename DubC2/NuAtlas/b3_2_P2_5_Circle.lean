/-- The certified shifts of the fundamental domain: 8 closed intervals. -/
def b3_2_P2_5_dom (ν : ℝ) : Prop :=
    ((1 / 2 : ℝ) ≤ ν ∧ ν ≤ (25 / 48 : ℝ)) ∨
    ((1079 / 1536 : ℝ) ≤ ν ∧ ν ≤ (13 / 16 : ℝ)) ∨
    ((4 / 3 : ℝ) ≤ ν ∧ ν ≤ (5 / 3 : ℝ)) ∨
    ((35 / 16 : ℝ) ≤ ν ∧ ν ≤ (3409 / 1536 : ℝ)) ∨
    ((163 / 48 : ℝ) ≤ ν ∧ ν ≤ (659 / 192 : ℝ)) ∨
    ((2683 / 768 : ℝ) ≤ ν ∧ ν ≤ (2693 / 768 : ℝ)) ∨
    ((685 / 192 : ℝ) ≤ ν ∧ ν ≤ (173 / 48 : ℝ)) ∨
    ((259 / 48 : ℝ) ≤ ν ∧ ν ≤ (173 / 32 : ℝ))

theorem b3_2_P2_5_of_dom {ξ ν : ℝ} (hξ : ξ ≠ 0) (h : b3_2_P2_5_dom ν) :
    ∃ᶠ n in atTop, ∃ ℓ ∈ ([2, 5] : List ℤ), ℓ ∣ Z32.xInt 3 2 ξ ν n := by
  simp only [b3_2_P2_5_dom] at h
  rcases h with h | h
  · exact b3_2_P2_5_iv1 hξ h.1 h.2
  rcases h with h | h
  · exact b3_2_P2_5_iv2 hξ h.1 h.2
  rcases h with h | h
  · exact b3_2_P2_5_iv3 hξ h.1 h.2
  rcases h with h | h
  · exact b3_2_P2_5_iv4 hξ h.1 h.2
  rcases h with h | h
  · exact b3_2_P2_5_iv5 hξ h.1 h.2
  rcases h with h | h
  · exact b3_2_P2_5_iv6 hξ h.1 h.2
  rcases h with h | h
  · exact b3_2_P2_5_iv7 hξ h.1 h.2
  exact b3_2_P2_5_iv8 hξ h.1 h.2

/-- **`[2, 5]` at `3/2` on the shift circle.**  For every real `ν` congruent mod `10`
to a certified shift or to its mirror image (`b3_2_P2_5_dom`), and every real `ξ ≠ 0`,
infinitely many of `⌊ξ(3/2)ⁿ + ν⌋` are divisible by a member of `[2, 5]`. -/
@[category research solved, AMS 11 37, ref "DN05", group "dubc2_shift"]
theorem b3_2_P2_5_circle {ξ ν : ℝ} (hξ : ξ ≠ 0)
    (h : ∃ k : ℤ, b3_2_P2_5_dom (ν - 10 * k) ∨ b3_2_P2_5_dom (1 - ν - 10 * k)) :
    ∃ᶠ n in atTop, ∃ ℓ ∈ ([2, 5] : List ℤ), ℓ ∣ ⌊ξ * ((3 : ℝ) / 2) ^ n + ν⌋ := by
  have := frequently_of_circle (p := 3) (q := 2) (L := 10) (by norm_num) (by norm_num)
    (by norm_num) (by decide) (fun ξ ν hξ h => b3_2_P2_5_of_dom hξ h) hξ
    (by simpa using h)
  simpa [Z32.xInt, Z32.orb] using this

