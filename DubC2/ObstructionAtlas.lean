import DubC2.ObstructionKit

/-!
# Two-letter obstructions across the atlas (generated)

Generated by `DubC2/obstruction_scan.py --emit`.  For every row `(p/q, ν)` of
`DubC2/atlas_out/atlas2.jsonl` and every divisor set of primes `≤ 13` with at most 4 members,
the scan looks for a witness of [Oda26] Theorem 42 (`DubC2.Gen.not_checked_of_two_letters`).
Listed here are the **maximal** killed sets of each row; each row is one theorem: no
certificate is checked for any parameter set of that base and shift whose prime lists lie
inside a listed witness's — for every cell count `D` and modulus `M`.

## References

* [Oda26] Y. Odagiri, *Finite graph certificates for composite terms in rational floor sequences*,
  Zenodo, doi:10.5281/zenodo.22997709 (2026).
-/

namespace DubC2.Gen.ObsAtlas

open DubC2.Gen

/-- Maximal two-letter-killed divisor sets at `3/2`, `ν = 0`. -/
def b3_2_nu0 : List Witness :=
  [⟨[3], [2], 1, -1, 1⟩]

/-- No certificate for `3/2`, `ν = 0`, with primes inside a listed set. -/
@[category research solved, AMS 11 37, ref "Oda26", group "dubc2_obstruction"]
theorem b3_2_nu0_killed : ∀ w ∈ b3_2_nu0, ∀ (P : Params) (C : Cert), P.p = 3 →
    P.q = 2 → P.a = 0 → P.b = 1 → (∀ l ∈ P.PM, l ∈ w.PM) →
    (∀ l ∈ P.Pq, l ∈ w.Pq) → ¬ Checked P C :=
  not_checked_of_row (by decide +kernel)

