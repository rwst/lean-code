/-- **`{2,5}`**: `dim_H {ξ : ⌊ξ(3/2)ⁿ⌋ eventually prime to 10} ≤ 7/10`. -/
@[category research solved, AMS 11 28, ref "DN05", group "dubc2_entropy"]
theorem floor_three_halves_avoid_two_five_dimH :
    dimH {ξ : ℝ | ∀ᶠ n in atTop,
      ¬ (2 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋ ∧ ¬ (5 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋}
      ≤ ENNReal.ofReal (7 / 10) := by
  have h := dimH_eventually_avoids_le ent32_2_5_check
  have hset : {ξ : ℝ | ∀ᶠ n in atTop,
      ¬ (2 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋ ∧ ¬ (5 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋}
      = {ξ : ℝ | ∀ᶠ n in atTop, Avoids ent32_2_5P ξ n} := by
    ext ξ
    simp [Avoids, xs, Z32.xInt, Z32.orb, Params.nu, ent32_2_5P, and_comm]
  rw [hset]
  refine h.trans (ENNReal.ofReal_le_ofReal ?_)
  have := log_div_log_le (x := 53 / 40) (y := 3 / 2) (c := 7) (d := 10) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)
  simpa [ent32_2_5E, ent32_2_5P] using this

