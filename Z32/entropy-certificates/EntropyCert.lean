namespace Z32.EntropyCert

open Filter Topology

/-! ## The certificate -/

/-- Twice the child of the scaled type `a` under the carry `s`: the type
recursion `t ↦ min (ℓ, (3t − s)/2)` scaled by `D` and doubled, so that no
division reaches the kernel.  The child is *live* exactly when this is positive.
-/
def child2 (D L a s : ℤ) : ℤ := min (2 * L) (3 * a - s * D)

/-- A **type certificate** for the anchored window `[0, L/D)` at the base `3/2`:
the common denominator, the window, the states with their weights, the labelled
edges, and the two certified ratios `a/b` (upper) and `a'/b'` (lower). -/
structure TypeCert where
  /-- The common denominator of the window and every state. -/
  D : ℤ
  /-- The window is `[0, L/D)`; `ok` checks `0 < 2L ≤ D`, i.e. `ℓ ≤ 1/2`. -/
  L : ℤ
  /-- The states — scaled cylinder-image right endpoints — with their weights. -/
  st : List (ℤ × ℕ)
  /-- The edges `(source, carry, target)`. -/
  ed : List (ℤ × ℤ × ℤ)
  /-- Numerator of the certified upper ratio. -/
  a : ℕ
  /-- Denominator of the certified upper ratio. -/
  b : ℕ
  /-- Numerator of the certified lower ratio. -/
  a' : ℕ
  /-- Denominator of the certified lower ratio. -/
  b' : ℕ
  /-- Lower bound for the weights; `ok` checks `0 < m`. -/
  m : ℕ
  /-- Upper bound for the weights. -/
  M : ℕ

namespace TypeCert

variable (c : TypeCert)

/-- The state values. -/
def states : List ℤ := c.st.map Prod.fst

/-- The weight of a state, defaulting to `m` off the state list — the shape the
*upper* certificate needs, where the weight must be bounded below by `m > 0`
everywhere. -/
def wt (x : ℤ) : ℕ := (c.st.lookup x).getD c.m

/-- The weight of a state, defaulting to `0` off the state list — the shape the
*lower* certificate needs, where a state with no outgoing edges must be allowed
to carry no weight. -/
def wt0 (x : ℤ) : ℕ := (c.st.lookup x).getD 0

/-- The edges out of `x`, as a list. -/
def outL (x : ℤ) : List (ℤ × ℤ × ℤ) := c.ed.filter fun e => decide (e.1 = x)

/-- The edge set, as the labelled digraph of `PathGrowth`. -/
def E : Finset (ℤ × ℤ × ℤ) := c.ed.toFinset

/-- The window the certificate speaks about. -/
def window : Set ℝ := Set.Ico 0 ((c.L : ℝ) / (c.D : ℝ))

/-- Base checks: a positive denominator, a window inside `[0,1/2]`, a listed
root, usable weight bounds and ratios, and no repeated edge. -/
def okBase : Bool :=
  decide (0 < c.D) && decide (0 < c.L) && decide (2 * c.L ≤ c.D) &&
    decide (c.L ∈ c.states) && decide (0 < c.m) && decide (c.m ≤ c.M) &&
    decide (0 < c.b) && decide (c.b ≤ c.a) && decide (0 < c.b') && decide (c.b' ≤ c.a')

/-- Every state is a live type inside the window, with an in-range weight. -/
def okStates : Bool :=
  c.st.all fun x =>
    decide (0 < x.1) && decide (x.1 ≤ c.L) && decide (c.m ≤ x.2) && decide (x.2 ≤ c.M)

/-- Every listed edge is a true transition between listed states, carrying one of
the two forced carries.  The alphabet clause is not decoration: an edge labelled
`−5` can satisfy the transition identity (the `min` is then attained by `2L`),
and it would inflate the word count with a transition no orbit can perform,
breaking the lower bound. -/
def okEdges : Bool :=
  c.ed.all fun e =>
    decide (e.1 ∈ c.states) && decide (e.2.2 ∈ c.states) && decide (0 < e.2.2) &&
      decide (e.2.1 = 0 ∨ e.2.1 = 1) &&
      decide (2 * e.2.2 = child2 c.D c.L e.1 e.2.1)

/-- Every true transition is listed: for each state and each of the two possible
carries, either the child is dead or an edge carries it.  With `okEdges` this
pins the graph down to *the* type graph. -/
def okTotal : Bool :=
  c.states.all fun x =>
    (decide (child2 c.D c.L x 0 ≤ 0) ||
      c.ed.any fun e => decide (e.1 = x) && decide (e.2.1 = 0)) &&
    (decide (child2 c.D c.L x 1 ≤ 0) ||
      c.ed.any fun e => decide (e.1 = x) && decide (e.2.1 = 1))

/-- The two vector inequalities, entrywise in `ℕ`, together with the only
duplication constraint the development needs: within one row the labels are
distinct.  A global `Nodup` on the edge list would do as well and is what the
first version checked, but it costs `#edges²` comparisons of big integers —
measured at `20 s` for `133` edges, half the total budget of the largest
certificate — whereas this costs `#edges` per state and is what
`List.sum_toFinset` actually consumes. -/
def okWeights : Bool :=
  c.states.all fun x =>
    decide (((c.outL x).map fun e => e.2.1).Nodup) &&
    decide (c.b * ((c.outL x).map fun e => c.wt e.2.2).sum ≤ c.a * c.wt x) &&
      decide (c.a' * c.wt0 x ≤ c.b' * ((c.outL x).map fun e => c.wt0 e.2.2).sum)

/-- The certificate is valid.  Every clause is a decidable statement about
integers, so `decide` checks it in the kernel. -/
def ok : Bool := c.okBase && c.okStates && c.okEdges && c.okTotal && c.okWeights

end TypeCert

/-! ## Unpacking `ok` -/

namespace TypeCert

variable {c : TypeCert}

private theorem of_mem_lookup {l : List (ℤ × ℕ)} {x : ℤ} {v : ℕ}
    (h : l.lookup x = some v) : (x, v) ∈ l := by
  induction l with
  | nil => simp [List.lookup] at h
  | cons p t ih =>
    rcases p with ⟨u, w⟩
    by_cases hx : x == u
    · have hux : x = u := by simpa using hx
      simp only [List.lookup, hx, Option.some.injEq] at h
      subst hux; subst h; exact List.mem_cons_self ..
    · simp only [List.lookup, hx] at h
      exact List.mem_cons_of_mem _ (ih h)

/-- Everything `okBase` certifies, unpacked once. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem base_parts (h : c.ok = true) :
    0 < c.D ∧ 0 < c.L ∧ 2 * c.L ≤ c.D ∧ c.L ∈ c.states ∧ 0 < c.m ∧ c.m ≤ c.M ∧
      0 < c.b ∧ c.b ≤ c.a ∧ 0 < c.b' ∧ c.b' ≤ c.a' := by
  simp only [ok, okBase, Bool.and_eq_true, decide_eq_true_eq] at h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> tauto

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem D_pos (h : c.ok = true) : 0 < c.D := (base_parts h).1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem L_pos (h : c.ok = true) : 0 < c.L := (base_parts h).2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem two_L_le_D (h : c.ok = true) : 2 * c.L ≤ c.D := (base_parts h).2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem L_mem (h : c.ok = true) : c.L ∈ c.states := (base_parts h).2.2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem m_pos (h : c.ok = true) : 0 < c.m := (base_parts h).2.2.2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem m_le_M (h : c.ok = true) : c.m ≤ c.M := (base_parts h).2.2.2.2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem b_pos (h : c.ok = true) : 0 < c.b := (base_parts h).2.2.2.2.2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem b_le_a (h : c.ok = true) : c.b ≤ c.a := (base_parts h).2.2.2.2.2.2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem b'_pos (h : c.ok = true) : 0 < c.b' := (base_parts h).2.2.2.2.2.2.2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem b'_le_a' (h : c.ok = true) : c.b' ≤ c.a' := (base_parts h).2.2.2.2.2.2.2.2.2



@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem state_parts (h : c.ok = true) {p : ℤ × ℕ} (hp : p ∈ c.st) :
    0 < p.1 ∧ p.1 ≤ c.L ∧ c.m ≤ p.2 ∧ p.2 ≤ c.M := by
  simp only [ok, okStates, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  have := h.1.1.1.2 p hp
  exact ⟨this.1.1.1, this.1.1.2, this.1.2, this.2⟩

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem edge_parts (h : c.ok = true) {e : ℤ × ℤ × ℤ} (he : e ∈ c.ed) :
    e.1 ∈ c.states ∧ e.2.2 ∈ c.states ∧ 0 < e.2.2 ∧ (e.2.1 = 0 ∨ e.2.1 = 1) ∧
      2 * e.2.2 = child2 c.D c.L e.1 e.2.1 := by
  simp only [ok, okEdges, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> have := h.1.1.2 e he <;> tauto

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem exists_edge (h : c.ok = true) {x s : ℤ} (hx : x ∈ c.states)
    (hs : s = 0 ∨ s = 1) (hlive : 0 < child2 c.D c.L x s) :
    ∃ w, (x, s, w) ∈ c.ed := by
  simp only [ok, okTotal, Bool.and_eq_true, List.all_eq_true, Bool.or_eq_true,
    decide_eq_true_eq, List.any_eq_true] at h
  have hall := h.1.2 x hx
  have hpick : ∃ e ∈ c.ed, e.1 = x ∧ e.2.1 = s := by
    rcases hs with rfl | rfl
    · rcases hall.1 with hdead | ⟨e, he, h1, h2⟩
      · exact absurd hlive (by omega)
      · exact ⟨e, he, h1, h2⟩
    · rcases hall.2 with hdead | ⟨e, he, h1, h2⟩
      · exact absurd hlive (by omega)
      · exact ⟨e, he, h1, h2⟩
  obtain ⟨e, he, h1, h2⟩ := hpick
  refine ⟨e.2.2, ?_⟩
  obtain ⟨e1, e2, e3⟩ := e
  simp only at h1 h2
  subst h1; subst h2
  exact he

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem weight_parts (h : c.ok = true) {x : ℤ} (hx : x ∈ c.states) :
    ((c.outL x).map fun e => e.2.1).Nodup ∧
      c.b * ((c.outL x).map fun e => c.wt e.2.2).sum ≤ c.a * c.wt x ∧
      c.a' * c.wt0 x ≤ c.b' * ((c.outL x).map fun e => c.wt0 e.2.2).sum := by
  simp only [ok, okWeights, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at h
  refine ⟨?_, ?_, ?_⟩ <;> have := h.2 x hx <;> tauto

/-- Each row is duplicate-free: distinct entries carry distinct labels. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem outL_nodup (h : c.ok = true) {x : ℤ} (hx : x ∈ c.states) : (c.outL x).Nodup :=
  List.Nodup.of_map _ (weight_parts h hx).1

/-! ### The weight functions are globally bounded

`wt` defaults to `m` and `wt0` to `0`, so both are bounded by `M` everywhere and
`wt` is bounded below by `m` everywhere — which is what `PathGrowth` asks for,
since its certificates quantify over the whole state type. -/

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem m_le_wt (h : c.ok = true) (x : ℤ) : c.m ≤ c.wt x := by
  rcases hl : c.st.lookup x with _ | v
  · simp [wt, hl]
  · simpa [wt, hl] using (state_parts h (of_mem_lookup hl)).2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem wt_le_M (h : c.ok = true) (x : ℤ) : c.wt x ≤ c.M := by
  rcases hl : c.st.lookup x with _ | v
  · simpa [wt, hl] using m_le_M h
  · simpa [wt, hl] using (state_parts h (of_mem_lookup hl)).2.2.2

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem wt0_le_M (h : c.ok = true) (x : ℤ) : c.wt0 x ≤ c.M := by
  rcases hl : c.st.lookup x with _ | v
  · simp [wt0, hl]
  · simpa [wt0, hl] using (state_parts h (of_mem_lookup hl)).2.2.2

private theorem lookup_isSome {l : List (ℤ × ℕ)} {x : ℤ} (hx : x ∈ l.map Prod.fst) :
    ∃ v, l.lookup x = some v := by
  induction l with
  | nil => simp at hx
  | cons p t ih =>
    by_cases hxp : x == p.1
    · exact ⟨p.2, by simp [List.lookup, hxp]⟩
    · have hxt : x ∈ t.map Prod.fst := by
        simp only [List.map_cons, List.mem_cons] at hx
        rcases hx with rfl | h
        · exact absurd (by simp) hxp
        · exact h
      obtain ⟨v, hv⟩ := ih hxt
      exact ⟨v, by simp [List.lookup, hxp, hv]⟩

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem wt0_pos_of_mem (h : c.ok = true) {x : ℤ} (hx : x ∈ c.states) : 0 < c.wt0 x := by
  obtain ⟨v, hl⟩ := lookup_isSome (l := c.st) (x := x) hx
  simpa [wt0, hl] using lt_of_lt_of_le (m_pos h) (state_parts h (of_mem_lookup hl)).2.2.1

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem state_pos (h : c.ok = true) {u : ℤ} (hu : u ∈ c.states) : 0 < u ∧ u ≤ c.L := by
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hu
  exact ⟨(state_parts h hp).1, (state_parts h hp).2.1⟩

/-! ## The geometry: one step of the type recursion -/

/-- The window lies in `[0, 1/2]`, which is what forces the carry alphabet. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem window_le_half (h : c.ok = true) : (c.L : ℝ) / (c.D : ℝ) ≤ 1 / 2 := by
  have hD : (0 : ℝ) < c.D := by exact_mod_cast D_pos h
  have h2 : (2 : ℝ) * c.L ≤ (c.D : ℝ) := by exact_mod_cast two_L_le_D h
  rw [div_le_div_iff₀ hD (by norm_num)]
  linarith

/-- On a window inside `[0,1/2)` the carry of a model orbit is forced into
`{0,1}`: this is plan-B10 §2's **F1**, at the level of the certificate. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem carry_eq (h : c.ok = true) {y : ℕ → ℝ} {s : ℕ → ℤ}
    (horb : IsModelOrbit 3 2 c.window y s) (n : ℕ) : s n = 0 ∨ s n = 1 := by
  obtain ⟨hw, -, hrec⟩ := horb
  have hhalf := window_le_half h
  have h0 : (0 : ℝ) ≤ y n := (hw n).1
  have h0' : (0 : ℝ) ≤ y (n + 1) := (hw (n + 1)).1
  have h1 : y n < 1 / 2 := lt_of_lt_of_le (hw n).2 hhalf
  have h1' : y (n + 1) < 1 / 2 := lt_of_lt_of_le (hw (n + 1)).2 hhalf
  have hr : (2 : ℝ) * y (n + 1) = 3 * y n - (s n : ℝ) := by
    have := hrec n; push_cast at this ⊢; linarith
  have hlt : ((s n : ℤ) : ℝ) < 2 := by linarith
  have hgt : ((-1 : ℤ) : ℝ) < ((s n : ℤ) : ℝ) := by push_cast; linarith
  have h2 : s n < 2 := by exact_mod_cast hlt
  have h3 : (-1 : ℤ) < s n := by exact_mod_cast hgt
  omega

/-- **The type invariant, one step.**  If the orbit is below the state `u` and
the carry `s` leads to the state `w`, the next point is below `w`.  This is the
whole geometric content of the certificate: `w` is a `min`, and the two branches
of that `min` are exactly the two ways the next point is constrained — by the
window, and by the image of `[0, u/D)`. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem step_lt (h : c.ok = true) {u w s : ℤ} (hw : 2 * w = child2 c.D c.L u s)
    {y y' : ℝ} (hy : y < (u : ℝ) / (c.D : ℝ)) (hy' : y' < (c.L : ℝ) / (c.D : ℝ))
    (hrec : 2 * y' = 3 * y - (s : ℝ)) : y' < (w : ℝ) / (c.D : ℝ) := by
  have hD : (0 : ℝ) < c.D := by exact_mod_cast D_pos h
  have hyD : y * (c.D : ℝ) < (u : ℝ) := (lt_div_iff₀ hD).mp hy
  have hy'D : y' * (c.D : ℝ) < (c.L : ℝ) := (lt_div_iff₀ hD).mp hy'
  have hmin : ((2 * w : ℤ) : ℝ) = min ((2 * c.L : ℤ) : ℝ) ((3 * u - s * c.D : ℤ) : ℝ) := by
    rw [hw]; simp only [child2, Int.cast_min]
  refine (lt_div_iff₀ hD).mpr ?_
  have hlt : 2 * (y' * (c.D : ℝ)) < ((2 * w : ℤ) : ℝ) := by
    rw [hmin]
    refine lt_min (by push_cast; linarith) ?_
    push_cast
    nlinarith [hrec]
  push_cast at hlt
  linarith

/-! ## Soundness: a confined orbit walks the graph -/

/-- **The block path, for the type graph.**  Every model orbit confined to the
window follows a path of the certificate's graph, starting at the root, with the
orbit staying below the current state throughout. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem exists_state_path (h : c.ok = true) {y : ℕ → ℝ} {s : ℕ → ℤ}
    (horb : IsModelOrbit 3 2 c.window y s) :
    ∃ A : ℕ → ℤ, A 0 = c.L ∧ (∀ n, A n ∈ c.states) ∧
      (∀ n, y n < (A n : ℝ) / (c.D : ℝ)) ∧ ∀ n, (A n, s n, A (n + 1)) ∈ c.ed := by
  classical
  have hD : (0 : ℝ) < c.D := by exact_mod_cast D_pos h
  have hLpos : (0 : ℝ) < (c.L : ℝ) / (c.D : ℝ) :=
    div_pos (by exact_mod_cast L_pos h) hD
  set g : ℕ → ℤ → ℤ :=
    fun n u => if hex : ∃ w, (u, s n, w) ∈ c.ed then hex.choose else 0 with hgdef
  set A : ℕ → ℤ := fun n => Nat.rec c.L (fun k ih => g k ih) n with hAdef
  have hA0 : A 0 = c.L := rfl
  have hAs : ∀ n, A (n + 1) = g n (A n) := fun _ => rfl
  -- the child is live at every step, because the orbit continues
  have hlive : ∀ n, A n ∈ c.states → y n < (A n : ℝ) / (c.D : ℝ) →
      0 < child2 c.D c.L (A n) (s n) := by
    intro n hmem hlt
    obtain ⟨hw, -, hrec⟩ := horb
    have hr : (2 : ℝ) * y (n + 1) = 3 * y n - (s n : ℝ) := by
      have := hrec n; push_cast at this ⊢; linarith
    have hyD : y n * (c.D : ℝ) < ((A n : ℤ) : ℝ) := (lt_div_iff₀ hD).mp hlt
    have h0' : (0 : ℝ) ≤ y (n + 1) := (hw (n + 1)).1
    have h2 : ((s n * c.D : ℤ) : ℝ) < ((3 * A n : ℤ) : ℝ) := by
      push_cast
      nlinarith
    have h3 : s n * c.D < 3 * A n := by exact_mod_cast h2
    simp only [child2, lt_min_iff]
    exact ⟨by linarith [L_pos h], by omega⟩
  -- the invariant, by induction
  have inv : ∀ n, A n ∈ c.states ∧ y n < (A n : ℝ) / (c.D : ℝ) := by
    intro n
    induction n with
    | zero => exact ⟨hA0 ▸ L_mem h, hA0 ▸ (horb.1 0).2⟩
    | succ n ih =>
      have hex : ∃ w, (A n, s n, w) ∈ c.ed :=
        exists_edge h ih.1 (carry_eq h horb n) (hlive n ih.1 ih.2)
      have hpick : (A n, s n, A (n + 1)) ∈ c.ed := by
        rw [hAs n, hgdef]
        simp only [dite_eq_left hex]
        exact hex.choose_spec
      refine ⟨(edge_parts h hpick).2.1, step_lt h (edge_parts h hpick).2.2.2.2 ih.2
        (horb.1 (n + 1)).2 ?_⟩
      have := horb.2.2 n; push_cast at this ⊢; linarith
  refine ⟨A, hA0, fun n => (inv n).1, fun n => (inv n).2, fun n => ?_⟩
  have hex : ∃ w, (A n, s n, w) ∈ c.ed :=
    exists_edge h (inv n).1 (carry_eq h horb n) (hlive n (inv n).1 (inv n).2)
  rw [hAs n, hgdef]
  simp only [dite_eq_left hex]
  exact hex.choose_spec

/-! ## The bridge to `PathGrowth`

The graph is deterministic — not by a check, but because the transition identity
determines the target from the source and the label.  That is what makes the
lower vector certificate applicable, and hence the lower bound available. -/

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem mem_ed_of_mem_E {e : ℤ × ℤ × ℤ} (he : e ∈ c.E) : e ∈ c.ed :=
  List.mem_toFinset.mp he

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem mem_E_of_mem_ed {e : ℤ × ℤ × ℤ} (he : e ∈ c.ed) : e ∈ c.E :=
  List.mem_toFinset.mpr he

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem deterministic (h : c.ok = true) : PathGrowth.Deterministic c.E := by
  intro e he f hf h1 h2
  have p1 := (edge_parts h (mem_ed_of_mem_E he)).2.2.2.2
  have p2 := (edge_parts h (mem_ed_of_mem_E hf)).2.2.2.2
  rw [h1, h2] at p1
  omega

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem outEdges_eq (x : ℤ) : PathGrowth.outEdges c.E x = (c.outL x).toFinset := by
  ext e
  simp [PathGrowth.outEdges, E, outL]

/-- The row sum of `PathGrowth` is the list sum the certificate checks.  This is
where `ed.Nodup` is spent: the `Finset` dedups, the list does not. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem sum_outEdges (h : c.ok = true) (f : ℤ → ℕ) {x : ℤ} (hx : x ∈ c.states) :
    ∑ e ∈ PathGrowth.outEdges c.E x, f e.2.2 = ((c.outL x).map fun e => f e.2.2).sum := by
  rw [outEdges_eq]
  exact List.sum_toFinset _ (outL_nodup h hx)

@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem outEdges_eq_empty (h : c.ok = true) {x : ℤ} (hx : x ∉ c.states) :
    PathGrowth.outEdges c.E x = ∅ := by
  refine Finset.eq_empty_of_forall_notMem fun e he => ?_
  simp only [PathGrowth.outEdges, Finset.mem_filter] at he
  exact hx (he.2 ▸ (edge_parts h (mem_ed_of_mem_E he.1)).1)

/-- The **upper** vector inequality, at every state of the ambient type `ℤ`:
off the state list there are no outgoing edges and `wt` is the constant `m`. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem cert_upper (h : c.ok = true) (x : ℤ) :
    c.b * ∑ e ∈ PathGrowth.outEdges c.E x, c.wt e.2.2 ≤ c.a * c.wt x := by
  by_cases hx : x ∈ c.states
  · rw [sum_outEdges h _ hx]; exact (weight_parts h hx).2.1
  · rw [outEdges_eq_empty h hx]; simp

/-- The **lower** vector inequality.  Here `wt0` vanishes off the state list,
which is exactly what makes the inequality `a' · 0 ≤ b' · 0` there. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem cert_lower (h : c.ok = true) (x : ℤ) :
    c.a' * c.wt0 x ≤ c.b' * ∑ e ∈ PathGrowth.outEdges c.E x, c.wt0 e.2.2 := by
  by_cases hx : x ∈ c.states
  · rw [sum_outEdges h _ hx]; exact (weight_parts h hx).2.2
  · have h0 : c.wt0 x = 0 := by
      rcases hl : c.st.lookup x with _ | v
      · simp [wt0, hl]
      · exact absurd (List.mem_map_of_mem (f := Prod.fst) (of_mem_lookup hl)) hx
    rw [outEdges_eq_empty h hx, h0]
    simp

/-! ## Exactness: the graph's words are the window's words -/

/-- A path realises its label word. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem word_mem_words {A : ℕ → ℤ} {s : ℕ → ℤ} (hpath : ∀ n, (A n, s n, A (n + 1)) ∈ c.ed) :
    ∀ (k n : ℕ), (List.ofFn fun i : Fin k => s (n + (i : ℕ))) ∈ PathGrowth.words c.E (A n) k := by
  intro k
  induction k with
  | zero => intro n; simp
  | succ k ih =>
    intro n
    rw [PathGrowth.words_succ, Finset.mem_biUnion]
    refine ⟨(A n, s n, A (n + 1)), ?_, ?_⟩
    · simp only [PathGrowth.outEdges, Finset.mem_filter]
      exact ⟨mem_E_of_mem_ed (hpath n), trivial⟩
    · refine Finset.mem_image.mpr
        ⟨List.ofFn fun i : Fin k => s (n + 1 + (i : ℕ)), ih (n + 1), ?_⟩
      rw [List.ofFn_succ]
      have htail : (fun i : Fin k => s (n + 1 + (i : ℕ)))
          = fun i : Fin k => s (n + ((i.succ : Fin (k + 1)) : ℕ)) := by
        funext i; congr 1; simp [Fin.val_succ]; omega
      simp [htail]

/-- **Realizability.**  Every word of the graph is the carry word of a genuine
confined model orbit.  The construction is one branch prepended to a shorter
orbit; the infinite tail is supplied by the fixed point `y ≡ 0`, which is
confined to every anchored window.  No fixed-point or intermediate-value
argument is needed anywhere. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem exists_orbit_of_mem_words (h : c.ok = true) :
    ∀ (k : ℕ) (u : ℤ), u ∈ c.states → ∀ w ∈ PathGrowth.words c.E u k,
      ∃ (y : ℕ → ℝ) (s : ℕ → ℤ), IsModelOrbit 3 2 c.window y s ∧
        y 0 < (u : ℝ) / (c.D : ℝ) ∧ w = List.ofFn fun i : Fin k => s (i : ℕ) := by
  have hD : (0 : ℝ) < c.D := by exact_mod_cast D_pos h
  have hLpos : (0 : ℝ) < (c.L : ℝ) / (c.D : ℝ) := div_pos (by exact_mod_cast L_pos h) hD
  have hhalf := window_le_half h
  intro k
  induction k with
  | zero =>
    intro u hu w hw
    simp only [PathGrowth.words_zero, Finset.mem_singleton] at hw
    refine ⟨fun _ => 0, fun _ => 0, ⟨fun n => ⟨le_refl 0, hLpos⟩,
      fun n => ⟨le_refl 0, one_pos⟩, fun n => by push_cast; ring⟩,
      div_pos (by exact_mod_cast (state_pos h hu).1) hD, by simp [hw]⟩
  | succ k ih =>
    intro u hu w hw
    rw [PathGrowth.words_succ, Finset.mem_biUnion] at hw
    obtain ⟨e, he, hw⟩ := hw
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hw
    simp only [PathGrowth.outEdges, Finset.mem_filter] at he
    obtain ⟨hemem, hesrc⟩ := he
    obtain ⟨hsrc, htgt, hpos, hlab, hid⟩ := edge_parts h (mem_ed_of_mem_E hemem)
    obtain ⟨y, s, horb, hy0, rfl⟩ := ih e.2.2 htgt v hv
    -- the numeric facts
    have hs0 : (0 : ℝ) ≤ (e.2.1 : ℝ) := by rcases hlab with h' | h' <;> simp [h']
    have hidle : 2 * e.2.2 ≤ 3 * u - e.2.1 * c.D := by
      rw [hid, hesrc]; exact min_le_right _ _
    have hy0D : y 0 * (c.D : ℝ) < ((e.2.2 : ℤ) : ℝ) := (lt_div_iff₀ hD).mp hy0
    have hidR : (2 : ℝ) * (e.2.2 : ℝ) ≤ 3 * (u : ℝ) - (e.2.1 : ℝ) * (c.D : ℝ) := by
      have : ((2 * e.2.2 : ℤ) : ℝ) ≤ ((3 * u - e.2.1 * c.D : ℤ) : ℝ) := by exact_mod_cast hidle
      push_cast at this; linarith
    have hnew0 : (0 : ℝ) ≤ (2 * y 0 + (e.2.1 : ℝ)) / 3 := by
      have := (horb.1 0).1; positivity
    have hnewu : (2 * y 0 + (e.2.1 : ℝ)) / 3 < (u : ℝ) / (c.D : ℝ) := by
      rw [lt_div_iff₀ hD, div_mul_eq_mul_div, div_lt_iff₀ (by norm_num : (0:ℝ) < 3)]
      nlinarith
    have huL : (u : ℝ) / (c.D : ℝ) ≤ (c.L : ℝ) / (c.D : ℝ) := by
      have huLZ : (u : ℝ) ≤ (c.L : ℝ) := by exact_mod_cast (state_pos h hu).2
      gcongr
    -- the orbit, one branch prepended
    set Y : ℕ → ℝ := fun n => Nat.rec ((2 * y 0 + (e.2.1 : ℝ)) / 3) (fun j _ => y j) n with hYdef
    set S : ℕ → ℤ := fun n => Nat.rec e.2.1 (fun j _ => s j) n with hSdef
    have hY0 : Y 0 = (2 * y 0 + (e.2.1 : ℝ)) / 3 := rfl
    have hYs : ∀ j, Y (j + 1) = y j := fun _ => rfl
    have hS0 : S 0 = e.2.1 := rfl
    have hSs : ∀ j, S (j + 1) = s j := fun _ => rfl
    have hY0u : Y 0 < (u : ℝ) / (c.D : ℝ) := by rw [hY0]; exact hnewu
    refine ⟨Y, S, ⟨fun n => ?_, fun n => ?_, fun n => ?_⟩, hY0u, ?_⟩
    · cases n with
      | zero => exact Set.mem_Ico.mpr ⟨hY0 ▸ hnew0, lt_of_lt_of_le hY0u huL⟩
      | succ j => rw [hYs]; exact horb.1 j
    · cases n with
      | zero =>
        refine Set.mem_Ico.mpr ⟨hY0 ▸ hnew0, ?_⟩
        have := lt_of_lt_of_le hY0u huL
        linarith
      | succ j => rw [hYs]; exact horb.2.1 j
    · cases n with
      | zero => rw [hYs, hY0, hS0]; push_cast; ring
      | succ j =>
        rw [hYs, hYs, hSs]
        have := horb.2.2 j
        push_cast at this ⊢
        linarith
    · rw [List.ofFn_succ]
      simp [hS0, hSs]

/-- **The certificate counts the window exactly, from above.** -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem card_modelLang_le (h : c.ok = true) (k : ℕ) :
    Nat.card (modelLang 3 2 c.window k) ≤ (PathGrowth.words c.E c.L k).card := by
  classical
  have hmem : ∀ v : modelLang 3 2 c.window k,
      (List.ofFn fun i : Fin k => (v.1 i)) ∈ PathGrowth.words c.E c.L k := by
    rintro ⟨v, y, s, horb, hval⟩
    obtain ⟨A, hA0, hAmem, hAlt, hpath⟩ := exists_state_path h horb
    have hw := word_mem_words (c := c) hpath k 0
    rw [hA0] at hw
    have hfun : (fun i : Fin k => s (0 + (i : ℕ))) = fun i : Fin k => v i := by
      funext i; rw [Nat.zero_add]; exact hval i
    rwa [hfun] at hw
  have hinj : Function.Injective fun v : modelLang 3 2 c.window k =>
      (⟨List.ofFn fun i : Fin k => (v.1 i), hmem v⟩ :
        {x // x ∈ PathGrowth.words c.E c.L k}) := by
    intro v v' hvv
    exact Subtype.ext (List.ofFn_injective (congrArg Subtype.val hvv))
  calc Nat.card (modelLang 3 2 c.window k)
      ≤ Nat.card {x // x ∈ PathGrowth.words c.E c.L k} := Nat.card_le_card_of_injective _ hinj
    _ = (PathGrowth.words c.E c.L k).card := by rw [Nat.card_eq_fintype_card, Fintype.card_coe]

/-- **…and from below**, which is realizability cashed in. -/
@[category API, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem le_card_modelLang (h : c.ok = true) (k : ℕ) :
    (PathGrowth.words c.E c.L k).card ≤ Nat.card (modelLang 3 2 c.window k) := by
  classical
  have hfin : Finite (modelLang 3 2 c.window k) :=
    (modelLang_finite (p := 3) (q := 2) (by norm_num) (by norm_num) c.window k).to_subtype
  have hchoice : ∀ w : {x // x ∈ PathGrowth.words c.E c.L k},
      ∃ v : Fin k → ℤ, v ∈ modelLang 3 2 c.window k ∧ w.1 = List.ofFn v := by
    rintro ⟨w, hw⟩
    obtain ⟨y, s, horb, -, hword⟩ := exists_orbit_of_mem_words h k c.L (L_mem h) w hw
    exact ⟨fun i : Fin k => s (i : ℕ), ⟨y, s, horb, fun _ => rfl⟩, hword⟩
  choose f hf1 hf2 using hchoice
  have hinj : Function.Injective fun w => (⟨f w, hf1 w⟩ : modelLang 3 2 c.window k) := by
    intro w w' hww
    have hf : f w = f w' := by simpa using congrArg Subtype.val hww
    exact Subtype.ext (by rw [hf2 w, hf2 w', hf])
  calc (PathGrowth.words c.E c.L k).card = Nat.card {x // x ∈ PathGrowth.words c.E c.L k} := by
        rw [Nat.card_eq_fintype_card, Fintype.card_coe]
    _ ≤ Nat.card (modelLang 3 2 c.window k) := Nat.card_le_card_of_injective _ hinj

/-- **The type graph is an exact model of the window's language.**  This is what
distinguishes the certificate from an enclosure: the same finite graph carries
both bounds, because it makes no error at all. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem card_modelLang_eq (h : c.ok = true) (k : ℕ) :
    Nat.card (modelLang 3 2 c.window k) = (PathGrowth.words c.E c.L k).card :=
  le_antisymm (card_modelLang_le h k) (le_card_modelLang h k)

end TypeCert

/-! ## From a geometric word count to `φ_model`

Two general facts about `phiModel`, stated here because this is the first file
that needs them; they belong upstream in `Z32/ModelEntropy.lean` next to
`Z32.phiModel_eq_zero_of_card_le`, which is their degenerate case. -/

/-- A language with at most `C · λⁿ` words of length `n` has growth rate at most
`log λ`. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem phiModel_le_of_card_le {p q : ℕ} {U : Set ℝ} {C lam : ℝ}
    (hC : 1 ≤ C) (hlam : 1 ≤ lam)
    (hcard : ∀ n, (Nat.card (modelLang p q U n) : ℝ) ≤ C * lam ^ n) :
    phiModel p q U ≤ Real.log lam := by
  have hC0 : (0 : ℝ) < C := lt_of_lt_of_le one_pos hC
  have hlogC : 0 ≤ Real.log C := Real.log_nonneg hC
  have hloglam : 0 ≤ Real.log lam := Real.log_nonneg hlam
  have hle : ∀ n : ℕ, Real.log (Nat.card (modelLang p q U n)) / n
      ≤ Real.log C / n + Real.log lam := by
    intro n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simpa using hloglam
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    rcases Nat.eq_zero_or_pos (Nat.card (modelLang p q U n)) with h0 | h0
    · rw [h0, Nat.cast_zero, Real.log_zero, zero_div]
      have h2 : 0 ≤ Real.log C / n := by positivity
      linarith
    · have h1 : Real.log (Nat.card (modelLang p q U n)) ≤ Real.log C + n * Real.log lam := by
        calc Real.log (Nat.card (modelLang p q U n))
            ≤ Real.log (C * lam ^ n) := Real.log_le_log (by exact_mod_cast h0) (hcard n)
          _ = Real.log C + n * Real.log lam := by
              rw [Real.log_mul (ne_of_gt hC0) (by positivity), Real.log_pow]
      rw [div_le_iff₀ hn', add_mul, div_mul_cancel₀ _ (ne_of_gt hn')]
      linarith
  have hg : Filter.Tendsto (fun n : ℕ => Real.log C / n + Real.log lam) Filter.atTop
      (nhds (Real.log lam)) := by
    simpa using (tendsto_const_div_atTop_nhds_zero_nat (Real.log C)).add
      (tendsto_const_nhds (x := Real.log lam) (f := Filter.atTop (α := ℕ)))
  refine le_trans (Filter.limsup_le_limsup (Filter.Eventually.of_forall hle) ?_ ?_)
    (le_of_eq hg.limsup_eq)
  · refine Filter.IsBoundedUnder.isCoboundedUnder_le ⟨0, ?_⟩
    simp only [Filter.eventually_map]
    filter_upwards with n
    exact div_nonneg (Real.log_natCast_nonneg _) (Nat.cast_nonneg n)
  · exact hg.isBoundedUnder_le

/-- A language with at least `C · λⁿ` words of length `n` has growth rate at
least `log λ`. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem le_phiModel_of_le_card {p q : ℕ} (hp : 0 < p) (hq : 0 < q) {U : Set ℝ} {C lam : ℝ}
    (hC : 0 < C) (hlam : 0 < lam)
    (hcard : ∀ n, C * lam ^ n ≤ (Nat.card (modelLang p q U n) : ℝ)) :
    Real.log lam ≤ phiModel p q U := by
  have hle : ∀ᶠ n : ℕ in Filter.atTop, Real.log C / n + Real.log lam
      ≤ Real.log (Nat.card (modelLang p q U n)) / n := by
    filter_upwards [Filter.eventually_gt_atTop 0] with n hn
    have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hpos : (0 : ℝ) < C * lam ^ n := by positivity
    have h0 : (0 : ℝ) < (Nat.card (modelLang p q U n) : ℝ) := lt_of_lt_of_le hpos (hcard n)
    have h1 : Real.log C + n * Real.log lam ≤ Real.log (Nat.card (modelLang p q U n)) := by
      calc Real.log C + n * Real.log lam = Real.log (C * lam ^ n) := by
            rw [Real.log_mul (ne_of_gt hC) (by positivity), Real.log_pow]
        _ ≤ Real.log (Nat.card (modelLang p q U n)) := Real.log_le_log hpos (hcard n)
    rw [div_add' _ _ _ (ne_of_gt hn'), div_le_div_iff_of_pos_right hn']
    linarith
  have hg : Filter.Tendsto (fun n : ℕ => Real.log C / n + Real.log lam) Filter.atTop
      (nhds (Real.log lam)) := by
    simpa using (tendsto_const_div_atTop_nhds_zero_nat (Real.log C)).add
      (tendsto_const_nhds (x := Real.log lam) (f := Filter.atTop (α := ℕ)))
  refine le_trans (ge_of_eq hg.limsup_eq) (Filter.limsup_le_limsup hle ?_ ?_)
  · exact hg.isBoundedUnder_ge.isCoboundedUnder_le
  · exact isBoundedUnder_phiModel hp hq U

namespace TypeCert

variable {c : TypeCert}

/-- **The certified upper enclosure.** -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem phiModel_le (h : c.ok = true) :
    phiModel 3 2 c.window ≤ Real.log ((c.a : ℝ) / (c.b : ℝ)) := by
  have hb : (0 : ℝ) < c.b := by exact_mod_cast b_pos h
  have hm : (0 : ℝ) < c.m := by exact_mod_cast m_pos h
  refine phiModel_le_of_card_le (C := (c.M : ℝ) / (c.m : ℝ)) ?_ ?_ fun n => ?_
  · rw [le_div_iff₀ hm, one_mul]; exact_mod_cast m_le_M h
  · rw [le_div_iff₀ hb, one_mul]; exact_mod_cast b_le_a h
  · calc (Nat.card (modelLang 3 2 c.window n) : ℝ)
        ≤ ((PathGrowth.words c.E c.L n).card : ℝ) := by exact_mod_cast card_modelLang_le h n
      _ ≤ (c.M : ℝ) / (c.m : ℝ) * ((c.a : ℝ) / (c.b : ℝ)) ^ n :=
          PathGrowth.card_words_le_pow c.E c.wt c.a c.b c.m c.M (b_pos h) (m_pos h)
            (m_le_wt h) (wt_le_M h) (cert_upper h) n c.L

/-- **The certified lower enclosure.**  This is the half that needs the graph to
be exact and deterministic. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem le_phiModel (h : c.ok = true) :
    Real.log ((c.a' : ℝ) / (c.b' : ℝ)) ≤ phiModel 3 2 c.window := by
  have hm0 : (0 : ℝ) < c.m := by exact_mod_cast m_pos h
  have hmM : (c.m : ℝ) ≤ (c.M : ℝ) := by exact_mod_cast m_le_M h
  have hM0 : (0 : ℝ) < c.M := lt_of_lt_of_le hm0 hmM
  have hb'0 : (0 : ℝ) < c.b' := by exact_mod_cast b'_pos h
  have ha'0 : (0 : ℝ) < c.a' := lt_of_lt_of_le hb'0 (by exact_mod_cast b'_le_a' h)
  have hroot : (0 : ℝ) < c.wt0 c.L := by exact_mod_cast wt0_pos_of_mem h (L_mem h)
  refine le_phiModel_of_le_card (by norm_num) (by norm_num)
    (C := (c.wt0 c.L : ℝ) / (c.M : ℝ)) (div_pos hroot hM0) (div_pos ha'0 hb'0) fun n => ?_
  have hraw : ((c.a' : ℝ)) ^ n * (c.wt0 c.L : ℝ)
      ≤ (c.M : ℝ) * (((c.b' : ℝ)) ^ n * ((PathGrowth.words c.E c.L n).card : ℝ)) := by
    exact_mod_cast PathGrowth.le_card_words (deterministic h) c.wt0 c.a' c.b' c.M
      (wt0_le_M h) (cert_lower h) n c.L
  have hcard : ((PathGrowth.words c.E c.L n).card : ℝ)
      ≤ (Nat.card (modelLang 3 2 c.window n) : ℝ) := by
    exact_mod_cast le_card_modelLang h n
  have hstep : (c.M : ℝ) * ((c.b' : ℝ) ^ n * ((PathGrowth.words c.E c.L n).card : ℝ))
      ≤ (c.M : ℝ) * ((c.b' : ℝ) ^ n * (Nat.card (modelLang 3 2 c.window n) : ℝ)) := by
    have hbn : (0 : ℝ) < (c.b' : ℝ) ^ n := pow_pos hb'0 n
    gcongr
  rw [div_pow, div_mul_div_comm, div_le_iff₀ (by positivity)]
  calc (c.wt0 c.L : ℝ) * (c.a' : ℝ) ^ n = (c.a' : ℝ) ^ n * (c.wt0 c.L : ℝ) := by ring

    _ ≤ (c.M : ℝ) * ((c.b' : ℝ) ^ n * ((PathGrowth.words c.E c.L n).card : ℝ)) := hraw
    _ ≤ (c.M : ℝ) * ((c.b' : ℝ) ^ n * (Nat.card (modelLang 3 2 c.window n) : ℝ)) := hstep
    _ = (Nat.card (modelLang 3 2 c.window n) : ℝ) * ((c.M : ℝ) * (c.b' : ℝ) ^ n) := by ring

/-- The two enclosures as one bracket — the shape the entries below report. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_phi_model"]
theorem mem_Icc (h : c.ok = true) :
    phiModel 3 2 c.window ∈
      Set.Icc (Real.log ((c.a' : ℝ) / (c.b' : ℝ))) (Real.log ((c.a : ℝ) / (c.b : ℝ))) :=
  ⟨le_phiModel h, phiModel_le h⟩

end TypeCert


