426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200  6) 
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200  7) theorem invariant_of_measurable_invariants
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200  8)     {f : α → α} {g : α → β} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSingletonClass β]
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200  9)     (h : Measurable[invariants f] g) : g ∘ f = g := by
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200 10)   funext x
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200 11)   suffices x ∈ f⁻¹' (g⁻¹' {g x}) by simpa
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200 12)   rw [(h <| measurableSet_singleton (g x)).2]
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200 13)   rfl
426aeb70 (Lua V. R. 2024-08-09 16:15:56 +0200 14) 
