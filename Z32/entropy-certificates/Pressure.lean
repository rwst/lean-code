namespace Z32.Pressure

open Filter Topology

set_option exponentiation.threshold 100000

/-! ## The branches are affine with a single slope

This is the whole reason the pressure below is affine, so it is worth having as a theorem rather
than as a remark. -/

/-- One forward branch of the model system: `y ↦ (p·y − s)/q`. -/
noncomputable def modelBranch (p q : ℕ) (s : ℤ) (y : ℝ) : ℝ :=
  ((p : ℝ) * y - (s : ℝ)) / (q : ℝ)

/-- A model orbit is a chain of branch applications. -/
@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem modelBranch_apply {p q : ℕ} (hq : 0 < q) {U : Set ℝ} {y s}
    (h : IsModelOrbit p q U y s) (n : ℕ) : y (n + 1) = modelBranch p q (s n) (y n) := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have := h.2.2 n
  rw [modelBranch, eq_div_iff (ne_of_gt hqR)]
  linarith

/-- **Every branch has the same slope `p/q`**, whichever carry `s` it belongs to: the difference
quotient is the constant `p/q`.  Hence `|T'| ≡ p/q`, the geometric potential `−t·log|T'|` is the
constant `−t·log(p/q)`, and its Birkhoff sum over a length-`k` word is `−t·k·log(p/q)`.  That is
the whole reason `modelPressure` below is affine in `t`. -/
@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem modelBranch_sub {q : ℕ} (hq : 0 < q) (p : ℕ) (s : ℤ) (y y' : ℝ) :
    modelBranch p q s y - modelBranch p q s y' = ((p : ℝ) / (q : ℝ)) * (y - y') := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  rw [modelBranch, modelBranch]
  field_simp
  ring

/-- **The cylinders contract by exactly `(q/p)^k`.**  `back p q · w` is the composed inverse
branch along the word `w`; it is affine with ratio `q/p`, so the interval of starting points
realising `w` has `(q/p)^{|w|}` times the diameter of its image.  This is the geometry that makes
`modelBowen` a conformal exponent. -/
@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem abs_back_sub {p q : ℕ} (hp : 0 < p) (z z' : ℝ) (w : List ℤ) :
    |back p q z w - back p q z' w| = ((q : ℝ) / (p : ℝ)) ^ w.length * |z - z'| := by
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp
  induction w with
  | nil => simp
  | cons s t ih =>
    have key : back p q z (s :: t) - back p q z' (s :: t)
        = ((q : ℝ) / (p : ℝ)) * (back p q z t - back p q z' t) := by
      rw [back_cons, back_cons]
      field_simp
      ring
    rw [key, abs_mul, abs_of_nonneg (by positivity), ih, List.length_cons]
    ring

/-! ## The language is never empty on a window containing `0` -/

/-- The fixed point `y ≡ 0` is a model orbit of every window containing `0`, so its language has
at least the all-zero word at every length.  This is what lets the partition function be
logarithmed. -/
@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem card_modelLang_pos {p q : ℕ} (hp : 0 < p) (hq : 0 < q) {U : Set ℝ}
    (h0 : (0 : ℝ) ∈ U) (k : ℕ) : 0 < Nat.card (modelLang p q U k) := by
  have hmem : (fun _ : Fin k => (0 : ℤ)) ∈ modelLang p q U k := by
    refine ⟨fun _ => 0, fun _ => 0, ⟨fun _ => h0, fun _ => ?_, fun _ => ?_⟩, fun _ => rfl⟩
    · exact Set.mem_Ico.mpr ⟨le_refl 0, one_pos⟩
    · simp
  exact Nat.card_pos_iff.mpr ⟨⟨⟨_, hmem⟩⟩, (modelLang_finite hp hq U k).to_subtype⟩

/-! ## The partition function and the pressure -/

/-- The **partition function** of the model system at inverse temperature `t`, for the geometric
potential `−t·log|T'|`.  All branches have slope `p/q` (`deriv_modelBranch`), so the Birkhoff sum
over a length-`k` word is the constant `−t·k·log(p/q)` and the sum over the language collapses to
a product. -/
noncomputable def modelPartition (p q : ℕ) (U : Set ℝ) (t : ℝ) (k : ℕ) : ℝ :=
  (Nat.card (modelLang p q U k) : ℝ) * Real.exp (-(t * k * Real.log ((p : ℝ) / (q : ℝ))))

/-- The **topological pressure** of the geometric potential on the hold set `U`. -/
noncomputable def modelPressure (p q : ℕ) (U : Set ℝ) (t : ℝ) : ℝ :=
  limsup (fun k : ℕ => Real.log (modelPartition p q U t k) / k) atTop

/-- **The pressure in closed form.**  A single-slope repeller has an affine pressure: one
certificate for `φ_model` encloses `P(t)` at *every* real `t`, on both sides. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelPressure_eq {p q : ℕ} (hp : 0 < p) (hq : 0 < q) {U : Set ℝ}
    (h0 : (0 : ℝ) ∈ U) (t : ℝ) :
    modelPressure p q U t = phiModel p q U - t * Real.log ((p : ℝ) / (q : ℝ)) := by
  set L := Real.log ((p : ℝ) / (q : ℝ)) with hL
  have heq : ∀ᶠ k : ℕ in atTop,
      Real.log (modelPartition p q U t k) / k
        = Real.log (Nat.card (modelLang p q U k)) / k + -(t * L) := by
    filter_upwards [eventually_ge_atTop 1] with k hk
    have hc : (0 : ℝ) < (Nat.card (modelLang p q U k) : ℝ) := by
      exact_mod_cast card_modelLang_pos hp hq h0 k
    have hk0 : (k : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    rw [modelPartition, Real.log_mul (ne_of_gt hc) (Real.exp_ne_zero _), Real.log_exp]
    field_simp
    ring
  have hbd := isBoundedUnder_phiModel hp hq U
  have hcb : IsCoboundedUnder (· ≤ ·) atTop
      (fun k : ℕ => Real.log (Nat.card (modelLang p q U k)) / k) :=
    Filter.isCoboundedUnder_le_of_le atTop (x := 0) fun k =>
      div_nonneg (Real.log_natCast_nonneg _) (Nat.cast_nonneg k)
  rw [modelPressure, limsup_congr heq, limsup_add_const atTop _ _ hbd hcb, phiModel]
  ring

/-! ### The base `3/2` -/

@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem log_three_halves_pos : 0 < Real.log (3 / 2 : ℝ) := Real.log_pos (by norm_num)

@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem log_two_pos : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)

/-- `modelPressure_eq` at `(p,q) = (3,2)`, with the cast cleared. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelPressure_three_two {U : Set ℝ} (h0 : (0 : ℝ) ∈ U) (t : ℝ) :
    modelPressure 3 2 U t = phiModel 3 2 U - t * Real.log (3 / 2) := by
  have hc : ((3 : ℕ) : ℝ) / ((2 : ℕ) : ℝ) = 3 / 2 := by norm_num
  have h := modelPressure_eq (p := 3) (q := 2) (by norm_num) (by norm_num) h0 t
  rw [hc] at h
  exact h

/-! ## The Bowen zero and the two exponent readings -/

/-- `modelExponent p q U r` — the exponent of the language count in base `r`: the count grows like
`r ^ (modelExponent · k)`. -/
noncomputable def modelExponent (p q : ℕ) (U : Set ℝ) (r : ℝ) : ℝ :=
  phiModel p q U / Real.log r

/-- The **Bowen zero**: the unique `t` at which the pressure vanishes.  Equivalently the exponent
of the language count in the base `3/2` — the reciprocal of the cylinders' contraction ratio, by
`abs_back_sub`. -/
noncomputable def modelBowen (U : Set ℝ) : ℝ := modelExponent 3 2 U (3 / 2)

/-- The **dyadic counting exponent**: the exponent of the language count in base `2`.  At the
Z-cell this is Flatto's `s` in `#Z(x) ≤ 3·x^s`. -/
noncomputable def flattoExponent (U : Set ℝ) : ℝ := modelExponent 3 2 U 2

/-- The two readings differ by the constant `log₂(3/2)`. -/
@[category research solved, AMS 11 37, ref "Fla92", group "z32_model_pressure"]
theorem flattoExponent_eq (U : Set ℝ) :
    flattoExponent U = modelBowen U * Real.logb 2 (3 / 2) := by
  rw [flattoExponent, modelBowen, modelExponent, modelExponent, Real.logb]
  field_simp

/-- **The pressure vanishes exactly at the Bowen zero.** -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelPressure_modelBowen {U : Set ℝ} (h0 : (0 : ℝ) ∈ U) :
    modelPressure 3 2 U (modelBowen U) = 0 := by
  rw [modelPressure_three_two h0, modelBowen, modelExponent]
  field_simp
  ring

/-- The pressure is strictly decreasing, so its zero is unique. -/
@[category research solved, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem strictAnti_modelPressure {U : Set ℝ} (h0 : (0 : ℝ) ∈ U) :
    StrictAnti (modelPressure 3 2 U) := by
  intro s t hst
  rw [modelPressure_three_two h0, modelPressure_three_two h0]
  have h := mul_lt_mul_of_pos_right hst log_three_halves_pos
  linarith

@[category research solved, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem modelBowen_of_pressure_eq_zero {U : Set ℝ} (h0 : (0 : ℝ) ∈ U) {t : ℝ}
    (ht : modelPressure 3 2 U t = 0) : t = modelBowen U := by
  rw [modelPressure_three_two h0] at ht
  rw [modelBowen, modelExponent, eq_div_iff (ne_of_gt log_three_halves_pos)]
  linarith

/-- **Monotone interval bracketing.**  The pressure is strictly decreasing, so a sign test at two
points brackets its zero — this is the whole of the "interval arithmetic" the Bowen zero needs. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelBowen_mem_Icc {U : Set ℝ} (h0 : (0 : ℝ) ∈ U) {t₁ t₂ : ℝ}
    (h1 : 0 ≤ modelPressure 3 2 U t₁) (h2 : modelPressure 3 2 U t₂ ≤ 0) :
    modelBowen U ∈ Set.Icc t₁ t₂ := by
  rw [modelPressure_three_two h0] at h1 h2
  have hL := log_three_halves_pos
  constructor
  · rw [modelBowen, modelExponent, le_div_iff₀ hL]; linarith
  · rw [modelBowen, modelExponent, div_le_iff₀ hL]; linarith

/-! ## Exponent bounds are rational power comparisons

`n/d ≤ log x / log r` is equivalent to `r^n ≤ x^d`, so nothing below ever evaluates a logarithm. -/

@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem div_le_log_div_log {r x : ℝ} (hr : 1 < r) (_hx : 0 < x) {n d : ℕ} (hd : 0 < d)
    (h : r ^ n ≤ x ^ d) : (n : ℝ) / d ≤ Real.log x / Real.log r := by
  have hlr : 0 < Real.log r := Real.log_pos hr
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hlog := Real.log_le_log (pow_pos (by linarith) n) h
  rw [Real.log_pow, Real.log_pow] at hlog
  rw [div_le_div_iff₀ hd' hlr]
  linarith

@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem log_div_log_le_div {r x : ℝ} (hr : 1 < r) (hx : 0 < x) {n d : ℕ} (hd : 0 < d)
    (h : x ^ d ≤ r ^ n) : Real.log x / Real.log r ≤ (n : ℝ) / d := by
  have hlr : 0 < Real.log r := Real.log_pos hr
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hlog := Real.log_le_log (pow_pos hx d) h
  rw [Real.log_pow, Real.log_pow] at hlog
  rw [div_le_div_iff₀ hlr hd']
  linarith

/-! ## The certificate layer -/

namespace TypeCert

open Z32.EntropyCert Z32.EntropyCert.TypeCert

variable {c : Z32.EntropyCert.TypeCert}

/-- Every anchored window contains `0`, so the pressure machinery applies to it. -/
@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem zero_mem_window (h : c.ok = true) : (0 : ℝ) ∈ c.window := by
  have hD : (0 : ℝ) < (c.D : ℝ) := by exact_mod_cast D_pos h
  have hL : (0 : ℝ) < (c.L : ℝ) := by exact_mod_cast L_pos h
  simp only [Z32.EntropyCert.TypeCert.window, Set.mem_Ico]
  exact ⟨le_refl 0, by positivity⟩

@[category API, AMS 11 37, ref "Dub09AA", group "z32_model_pressure"]
theorem ratio_pos (h : c.ok = true) : (0 : ℝ) < (c.a : ℝ) / (c.b : ℝ) := by
  have hb : (0 : ℝ) < (c.b : ℝ) := by exact_mod_cast b_pos h
  have ha : (0 : ℝ) < (c.a : ℝ) := by
    have := b_pos h; have := b_le_a h; exact_mod_cast lt_of_lt_of_le ‹0 < c.b› ‹c.b ≤ c.a›
  positivity

/-- **The certified pressure enclosure, at every real `t`.**  `P_lo(t) ≤ P(t) ≤ P_hi(t)` with the
two bounds differing only by the certificate's own bracket on `φ_model`: the `t`-dependence is
common to both sides, which is what "the pressure is affine" buys. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelPressure_mem_Icc (h : c.ok = true) (t : ℝ) :
    modelPressure 3 2 c.window t ∈
      Set.Icc (Real.log ((c.a' : ℝ) / (c.b' : ℝ)) - t * Real.log (3 / 2))
        (Real.log ((c.a : ℝ) / (c.b : ℝ)) - t * Real.log (3 / 2)) := by
  have hb := Z32.EntropyCert.TypeCert.mem_Icc h
  rw [modelPressure_three_two (zero_mem_window h)]
  exact ⟨by linarith [hb.1], by linarith [hb.2]⟩

/-- **The pressure at a rational `t` is nonnegative, decided by an integer comparison.** -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelPressure_nonneg_of_pow (h : c.ok = true) {u : ℝ} (hu : 0 < u)
    (hu' : u ≤ (c.a' : ℝ) / (c.b' : ℝ)) {n d : ℕ} (hd : 0 < d)
    (hpow : ((3 : ℝ) / 2) ^ n ≤ u ^ d) : 0 ≤ modelPressure 3 2 c.window ((n : ℝ) / d) := by
  have hL := log_three_halves_pos
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have h1 : (n : ℝ) / d ≤ Real.log u / Real.log (3 / 2) :=
    div_le_log_div_log (by norm_num) hu hd hpow
  have h2 : Real.log u ≤ phiModel 3 2 c.window :=
    le_trans (Real.log_le_log hu hu') (Z32.EntropyCert.TypeCert.mem_Icc h).1
  have h3 : ((n : ℝ) / d) * Real.log (3 / 2) ≤ Real.log u := by
    rw [div_mul_eq_mul_div, div_le_iff₀ hd']
    rw [div_le_div_iff₀ hd' hL] at h1
    linarith
  rw [modelPressure_three_two (zero_mem_window h)]
  linarith

/-- **The pressure at a rational `t` is nonpositive, decided by an integer comparison.** -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelPressure_nonpos_of_pow (h : c.ok = true) {v : ℝ}
    (hv' : (c.a : ℝ) / (c.b : ℝ) ≤ v) {n d : ℕ} (hd : 0 < d)
    (hpow : v ^ d ≤ ((3 : ℝ) / 2) ^ n) : modelPressure 3 2 c.window ((n : ℝ) / d) ≤ 0 := by
  have hL := log_three_halves_pos
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hv : (0 : ℝ) < v := lt_of_lt_of_le (ratio_pos h) hv'
  have h1 : Real.log v / Real.log (3 / 2) ≤ (n : ℝ) / d :=
    log_div_log_le_div (by norm_num) hv hd hpow
  have h2 : phiModel 3 2 c.window ≤ Real.log v :=
    le_trans (Z32.EntropyCert.TypeCert.mem_Icc h).2 (Real.log_le_log (ratio_pos h) hv')
  have h3 : Real.log v ≤ ((n : ℝ) / d) * Real.log (3 / 2) := by
    rw [div_mul_eq_mul_div, le_div_iff₀ hd']
    rw [div_le_div_iff₀ hL hd'] at h1
    linarith
  rw [modelPressure_three_two (zero_mem_window h)]
  linarith

/-- **The Bowen zero, bracketed by two integer comparisons.**  Run the sign test at `n₁/d₁` and at
`n₂/d₂`; monotonicity of the pressure does the rest. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelBowen_mem_Icc_of_pow (h : c.ok = true) {u v : ℝ} (hu : 0 < u)
    (hu' : u ≤ (c.a' : ℝ) / (c.b' : ℝ)) (hv' : (c.a : ℝ) / (c.b : ℝ) ≤ v)
    {n₁ d₁ n₂ d₂ : ℕ} (hd₁ : 0 < d₁) (hd₂ : 0 < d₂)
    (hp₁ : ((3 : ℝ) / 2) ^ n₁ ≤ u ^ d₁) (hp₂ : v ^ d₂ ≤ ((3 : ℝ) / 2) ^ n₂) :
    modelBowen c.window ∈ Set.Icc ((n₁ : ℝ) / d₁) ((n₂ : ℝ) / d₂) :=
  modelBowen_mem_Icc (zero_mem_window h)
    (modelPressure_nonneg_of_pow h hu hu' hd₁ hp₁)
    (modelPressure_nonpos_of_pow h hv' hd₂ hp₂)

/-- The same for the exponent in an arbitrary base `r > 1` — the dyadic reading is `r = 2`. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem modelExponent_mem_Icc_of_pow (h : c.ok = true) {r u v : ℝ} (hr : 1 < r) (hu : 0 < u)
    (hu' : u ≤ (c.a' : ℝ) / (c.b' : ℝ)) (hv' : (c.a : ℝ) / (c.b : ℝ) ≤ v)
    {n₁ d₁ n₂ d₂ : ℕ} (hd₁ : 0 < d₁) (hd₂ : 0 < d₂)
    (hp₁ : r ^ n₁ ≤ u ^ d₁) (hp₂ : v ^ d₂ ≤ r ^ n₂) :
    modelExponent 3 2 c.window r ∈ Set.Icc ((n₁ : ℝ) / d₁) ((n₂ : ℝ) / d₂) := by
  have hlr : 0 < Real.log r := Real.log_pos hr
  have hv : (0 : ℝ) < v := lt_of_lt_of_le (ratio_pos h) hv'
  have hb := Z32.EntropyCert.TypeCert.mem_Icc h
  constructor
  · calc (n₁ : ℝ) / d₁ ≤ Real.log u / Real.log r := div_le_log_div_log hr hu hd₁ hp₁
      _ ≤ modelExponent 3 2 c.window r := by
          rw [modelExponent]
          gcongr
          exact le_trans (Real.log_le_log hu hu') hb.1
  · calc modelExponent 3 2 c.window r ≤ Real.log v / Real.log r := by
          rw [modelExponent]
          gcongr
          exact le_trans hb.2 (Real.log_le_log (ratio_pos h) hv')
      _ ≤ (n₂ : ℝ) / d₂ := log_div_log_le_div hr hv hd₂ hp₂

/-! ### The weighted transfer operator, and why it factors

`PathGrowth.psum c.E (fun _ => θ) g` is the `θ`-weighted transfer operator of the type graph.  A
constant weight is all a single-slope map produces, and it factors out. -/

/-- Weighting every edge by `θ` multiplies the count by exactly `θ^k` — combined with
`card_modelLang_eq`, the operator statement of "the pressure is affine". -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem psum_eq_card_modelLang (h : c.ok = true) (θ k : ℕ) :
    PathGrowth.psum c.E (fun _ => θ) (fun _ => 1) c.L k
      = θ ^ k * Nat.card (modelLang 3 2 c.window k) := by
  rw [PathGrowth.psum_const (deterministic h) θ k c.L, card_modelLang_eq h k]

/-- The upper certificate transports to the `θ`-weighted operator with the ratio multiplied by
`θ`.  (The general lemma is `PathGrowth.psum_le_pow`; only the row inequality is re-checked.) -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem weighted_psum_le (h : c.ok = true) (θ k : ℕ) :
    ((PathGrowth.psum c.E (fun _ => θ) c.wt c.L k : ℕ) : ℝ)
      ≤ (((θ * c.a : ℕ) : ℝ) / (c.b : ℝ)) ^ k * (c.wt c.L : ℝ) := by
  refine PathGrowth.psum_le_pow c.E _ c.wt c.wt (θ * c.a) c.b (b_pos h) (fun _ => le_refl _)
    (fun x => ?_) k c.L
  calc c.b * ∑ e ∈ PathGrowth.outEdges c.E x, θ * c.wt e.2.2
      = θ * (c.b * ∑ e ∈ PathGrowth.outEdges c.E x, c.wt e.2.2) := by
        rw [← Finset.mul_sum]; ring
    _ ≤ θ * (c.a * c.wt x) := Nat.mul_le_mul_left _ (cert_upper h x)
    _ = θ * c.a * c.wt x := by ring

/-- The lower certificate likewise. -/
@[category research solved, AMS 11 37, ref "Dub09AA" "Fla92", group "z32_model_pressure"]
theorem weighted_le_psum (h : c.ok = true) (θ k : ℕ) :
    (((θ * c.a' : ℕ) : ℝ) / (c.b' : ℝ)) ^ k * (c.wt0 c.L : ℝ)
      ≤ ((PathGrowth.psum c.E (fun _ => θ) c.wt0 c.L k : ℕ) : ℝ) := by
  refine PathGrowth.pow_le_psum c.E _ c.wt0 c.wt0 (θ * c.a') c.b' (b'_pos h) (fun _ => le_refl _)
    (fun x => ?_) k c.L
  calc θ * c.a' * c.wt0 x = θ * (c.a' * c.wt0 x) := by ring
    _ ≤ θ * (c.b' * ∑ e ∈ PathGrowth.outEdges c.E x, c.wt0 e.2.2) :=
        Nat.mul_le_mul_left _ (cert_lower h x)
    _ = c.b' * ∑ e ∈ PathGrowth.outEdges c.E x, θ * c.wt0 e.2.2 := by
        rw [← Finset.mul_sum]; ring

end TypeCert

/-! ## The Z-cell: the exact endpoint of the family -/

@[category API, AMS 11 37, ref "Fla92", group "z32_model_pressure"]
theorem zero_mem_zCell : (0 : ℝ) ∈ Flatto.zCell := by
  simp [Flatto.zCell]

/-- **The pressure at the Z-cell, exactly.**  `P(t) = (1 − t)·log(3/2)`, so the Bowen zero is
`t = 1`. -/
@[category research solved, AMS 11 37, ref "Fla92" "Dub09AA", group "z32_model_pressure",
  formal_uses modelPressure_three_two]
theorem modelPressure_zCell (t : ℝ) :
    modelPressure 3 2 Flatto.zCell t = (1 - t) * Real.log (3 / 2) := by
  rw [modelPressure_three_two zero_mem_zCell, Flatto.phiModel_zCell]
  ring

/-- **The conformal exponent saturates at the Z-cell**: the Bowen zero is exactly `1`.  This is
plan-B10's F2 wall in dimension language — the model's own geometry cannot see anything below the
top of the window family, which is why the informative reading is the dyadic one below. -/
@[category research solved, AMS 11 37, ref "Fla92" "Dub09AA", group "z32_model_pressure",
  formal_uses modelPressure_zCell]
theorem modelBowen_zCell : modelBowen Flatto.zCell = 1 := by
  rw [modelBowen, modelExponent, Flatto.phiModel_zCell]
  exact div_self (ne_of_gt log_three_halves_pos)

/-- **The dyadic exponent at the Z-cell is exactly `log₂(3/2) = 0.5849…`** — Flatto's `s₀`, and the
`0.585` that plan-B10's wall and Table C's M3¾ constant both name. -/
@[category research solved, AMS 11 37, ref "Fla92", group "z32_model_pressure",
  formal_uses flattoExponent_eq modelBowen_zCell]
theorem flattoExponent_zCell : flattoExponent Flatto.zCell = Real.logb 2 (3 / 2) := by
  rw [flattoExponent_eq, modelBowen_zCell, one_mul]

