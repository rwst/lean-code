import DubC2.NuInterval
import DubC2.Mirror

/-!
# The shift circle: periodicity and the mirror

A divisor set `𝒫` with `ℓ ∣ L` for every `ℓ ∈ 𝒫` is unavoidable at `ν` iff it is at `ν + L·k`
(the terms shift by `L·k`), and iff it is at `1 − ν` (`DubC2.Mirror.frequently_mirror_iff`).  So
a statement proved on a fundamental domain of the group generated by `ν ↦ ν + L` and `ν ↦ 1 − ν`
covers the whole circle `ℝ/Lℤ` (`frequently_of_circle`).  The shift-interval atlas
(`DubC2/NuAtlas/`) proves its cells on the domain `[½, L/2 + ½]` and reads off the rest here.
-/

namespace DubC2.Gen

open Filter

/-- The terms at `ν + m` are the terms at `ν`, plus `m`. -/
theorem xInt_add_int (p q : ℕ) (ξ ν : ℝ) (m : ℤ) (n : ℕ) :
    Z32.xInt p q ξ (ν + m) n = Z32.xInt p q ξ ν n + m := by
  simp only [Z32.xInt, Z32.orb, ← add_assoc, Int.floor_add_intCast]

/-- **The shift circle.**  A divisor-set statement proved for every `ξ ≠ 0` on a set `S` of
shifts holds at every `ν` congruent mod `L` to a point of `S` or of its mirror image `1 − S`. -/
@[category API, AMS 11 37, ref "DN05", group "dubc2_shift"]
theorem frequently_of_circle {p q : ℕ} (hq : 1 < q) (hpq : q < p) (hcop : Nat.Coprime p q)
    {l : List ℤ} {L : ℤ} (hL : ∀ ℓ ∈ l, ℓ ∣ L) {S : ℝ → Prop}
    (hS : ∀ ξ ν, ξ ≠ 0 → S ν → ∃ᶠ n in atTop, ∃ ℓ ∈ l, ℓ ∣ Z32.xInt p q ξ ν n)
    {ξ ν : ℝ} (hξ : ξ ≠ 0) (h : ∃ k : ℤ, S (ν - L * k) ∨ S (1 - ν - L * k)) :
    ∃ᶠ n in atTop, ∃ ℓ ∈ l, ℓ ∣ Z32.xInt p q ξ ν n := by
  obtain ⟨k, hk⟩ := h
  -- shifting by a multiple of `L` does not change divisibility
  have shift : ∀ (ξ' ν' : ℝ), (∃ᶠ n in atTop, ∃ ℓ ∈ l, ℓ ∣ Z32.xInt p q ξ' ν' n) →
      ∃ᶠ n in atTop, ∃ ℓ ∈ l, ℓ ∣ Z32.xInt p q ξ' (ν' + (L * k : ℤ)) n := fun ξ' ν' h' =>
    h'.mono fun n ⟨ℓ, hℓ, hd⟩ => ⟨ℓ, hℓ, by
      rw [xInt_add_int]; exact dvd_add hd ((hL ℓ hℓ).mul_right k)⟩
  rcases hk with hk | hk
  · have := shift ξ _ (hS ξ _ hξ hk)
    simpa using this
  · have h1 := hS (-ξ) _ (neg_ne_zero.2 hξ) hk
    have h2 := (Mirror.frequently_mirror_iff hq hpq hcop (neg_ne_zero.2 hξ)
      (R := fun z => ∃ ℓ ∈ l, ℓ ∣ z) (fun z => by simp only [dvd_neg])).1 h1
    have := shift ξ _ (by simpa using h2)
    have e : 1 - (1 - ν - L * k) + ((L * k : ℤ) : ℝ) = ν + 2 * (L * k) := by push_cast; ring
    rw [e] at this
    -- `2·L·k` more: shift back by `−L·k`
    have h3 : ∃ᶠ n in atTop, ∃ ℓ ∈ l, ℓ ∣ Z32.xInt p q ξ (ν + 2 * (L * k)) n := this
    refine h3.mono fun n ⟨ℓ, hℓ, hd⟩ => ⟨ℓ, hℓ, ?_⟩
    have e2 : Z32.xInt p q ξ (ν + 2 * (L * k)) n = Z32.xInt p q ξ ν n + 2 * (L * k) := by
      rw [show (ν + 2 * (L * k) : ℝ) = ν + ((2 * (L * k) : ℤ) : ℝ) by push_cast; ring, xInt_add_int]
    rw [e2] at hd
    have : ℓ ∣ 2 * (L * k) := ((hL ℓ hℓ).mul_right k).mul_left 2
    exact (dvd_add_left this).1 hd

end DubC2.Gen
