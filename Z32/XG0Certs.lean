@[category research solved, AMS 11 37, ref "Dub06JNT" "Dub09AA" "Dub10", group "z32_block_cert"]
theorem not_eventually_two_cell_238 {ξ : ℝ} (hξ : ξ ≠ 0) {N : ℕ} :
    ¬ ∀ n : ℕ, N ≤ n → Int.fract (ξ * ((3 : ℝ) / 2) ^ n) ∈
      Set.Ico (0 : ℝ) (119 / 500) ∪ Set.Ico (381 / 500 : ℝ) 1 := by
  intro h
  refine Cert.not_eventually_confined certTwoCell238_ok hξ (N := N) fun n hn => ?_
