    dimH {ξ : ℝ | ∀ᶠ n in atTop, ¬ (2 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋ ∧
      ¬ (5 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋ ∧ ¬ (7 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋}
      ≤ ENNReal.ofReal (12 / 25) := by
  have h := dimH_eventually_avoids_le ent32_2_5_7_check
  have hset : {ξ : ℝ | ∀ᶠ n in atTop, ¬ (2 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋ ∧
      ¬ (5 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋ ∧ ¬ (7 : ℤ) ∣ ⌊ξ * (3 / 2 : ℝ) ^ n⌋}
      = {ξ : ℝ | ∀ᶠ n in atTop, Avoids ent32_2_5_7P ξ n} := by
    ext ξ
    simp [Avoids, xs, Z32.xInt, Z32.orb, Params.nu, ent32_2_5_7P]
    exact exists_congr fun a => forall_congr' fun b => imp_congr_right fun _ => by tauto
  rw [hset]
  refine h.trans (ENNReal.ofReal_le_ofReal ?_)
  have := log_div_log_le (x := 109 / 90) (y := 3 / 2) (c := 12) (d := 25) (by norm_num)
    (by norm_num) (by norm_num) (by norm_num)
  simpa [ent32_2_5_7E, ent32_2_5_7P] using this

