/-!
# Recurrent carries force composites ([Oda26] §10 and Appendix B)

For `a > b ≥ 2` coprime and `ξ > 0`, let `Qₙ = ⌊ξ(a/b)ⁿ⌋` and `cₙ = b·Q_{n+1} − a·Qₙ` (the carry
word; `Z32.xInt`/`Z32.carry` at shift `0`).  `Oda.Qf a b ξ ν`/`Oda.cf a b ξ ν` carry a general
shift `ν` (`Qₙ = ⌊ξ(a/b)ⁿ + ν⌋`, e.g. `ν = ½` for nearest integers); every result of this file holds
for every shift, so it applies verbatim to the shifted sequences of `DubC2/`.  [DN05] Lemma 2 (`Z32.not_isEventuallyPeriodic_carry`)
says `c` is never eventually periodic.  Odagiri's Theorem 46 is the complementary statement for the
next weakest regularity: if some tail of `c` is merely **recurrent** (every prefix of it occurs again
arbitrarily far out), then `(Qₙ)` has infinitely many composite terms, and every term `Qⱼ > 1` of the
tail prime to `ab` divides infinitely many later terms.  So an orbit whose terms are eventually all
prime has no recurrent carry tail (Corollary 51).

The engine is a return argument in the spirit of [Dub09] Theorem 4 (which needs a periodic word):
the letters act on `ℤ/M` by the affine permutations `x ↦ b⁻¹(ax + c)`, and the **finite-prefix
copying lemma** (Lemma 49) replaces periodicity in producing a return to the *initial* residue.

## Main results

* `Oda.IsRecurrent.tail` — Lemma 48.
* `Oda.copying` — Lemma 49, for any finite set and any injective letter actions.
* `Oda.residue_recurrence` — Theorem 50.
* `Oda.dvd_frequently_of_recurrent`, `Oda.composite_frequently_of_recurrent` — Theorem 46.
* `Oda.not_recurrent_of_eventually_prime` — Corollary 51.

## References

* [Oda26] Y. Odagiri, *Finite graph certificates for composite terms in rational floor sequences*,
  Zenodo, doi:10.5281/zenodo.22997709 (2026) — Theorem 46, Lemmas 48–49, Theorem 50, Corollary 51.
* [Dub09] A. Dubickas, *On integer sequences generated by linear maps*, Glasgow Math. J. **51**
  (2009), 243–252 — Theorem 4.
-/

namespace Oda

open Filter

/-! ## Recurrent words -/

/-- An infinite word is **recurrent** if every prefix occurs again arbitrarily far out. -/
def IsRecurrent {α : Type*} (w : ℕ → α) : Prop :=
  ∀ L B : ℕ, ∃ n, B ≤ n ∧ ∀ i, i < L → w (n + i) = w i

/-- **[Oda26] Lemma 48.** Every tail of a recurrent word is recurrent. -/
@[category research solved, AMS 68, ref "Oda26", group "oda26_recurrence"]
theorem IsRecurrent.tail {α : Type*} {w : ℕ → α} (h : IsRecurrent w) (k : ℕ) :
    IsRecurrent fun n => w (k + n) := by
  intro L B
  obtain ⟨n, hn, hw⟩ := h (k + L) B
  refine ⟨n, hn, fun i hi => ?_⟩
  show w (k + (n + i)) = w (k + i)
  rw [show k + (n + i) = n + (k + i) by ring]
  exact hw (k + i) (by omega)

/-! ## The finite-prefix copying lemma -/

section Copying

variable {X α : Type*} (f : α → X → X) (w : ℕ → α)

/-- `Gₙ = f(w_{n−1}) ∘ ⋯ ∘ f(w₀)`: the action of the prefix of length `n` (first letter first). -/
def G : ℕ → X → X
  | 0 => id
  | n + 1 => f (w n) ∘ G n

variable {f w}

theorem G_injective (hf : ∀ c, Function.Injective (f c)) (n : ℕ) : Function.Injective (G f w n) := by
  induction n with
  | zero => exact Function.injective_id
  | succ n ih => exact (hf _).comp ih

/-- The composition rule: if the word repeats its first `s` letters at position `t`, then
`G_{t+s} = G_s ∘ G_t`. -/
theorem G_add {t s : ℕ} (hw : ∀ i, i < s → w (t + i) = w i) : G f w (t + s) = G f w s ∘ G f w t := by
  induction s with
  | zero => rfl
  | succ s ih =>
    rw [show t + (s + 1) = (t + s) + 1 by ring]
    simp only [G]
    rw [ih (fun i hi => hw i (by omega)), hw s (by omega)]
    rfl

/-- **[Oda26] Lemma 49 (finite-prefix copying).**  Let the letters act injectively on a finite set
`X` of at most `m` elements.  Suppose copy times `t₀, …, t_{m−1} > 0` with partial sums `S` are such
that the word repeats its prefix of length `S_k + L` at position `t_k`.  Then every `x` returns:
some block sum `n = S_j − S_i > 0` (`i < j ≤ m`) has `Gₙ(x) = x`, and the prefix of length `L`
recurs at `n`. -/
@[category research solved, AMS 68, ref "Oda26", group "oda26_recurrence"]
theorem copying [Fintype X] (hf : ∀ c, Function.Injective (f c)) {L m : ℕ}
    (hm : Fintype.card X ≤ m) {S t : ℕ → ℕ} (hS0 : S 0 = 0) (hS : ∀ k, S (k + 1) = S k + t k)
    (ht : ∀ k, k < m → 0 < t k) (hcopy : ∀ k, k < m → ∀ i, i < S k + L → w (t k + i) = w i)
    (x : X) :
    ∃ i j, i < j ∧ j ≤ m ∧ t (j - 1) ≤ S j - S i ∧ G f w (S j - S i) x = x ∧
      ∀ l, l < L → w (S j - S i + l) = w l := by
  have hmono : Monotone S := monotone_nat_of_le_succ fun k => by rw [hS k]; omega
  -- copies compose along consecutive blocks
  have key : ∀ i j, i ≤ j → j ≤ m → G f w (S j) = G f w (S i) ∘ G f w (S j - S i) ∧
      ∀ l, l < L → w (S j - S i + l) = w l := by
    intro i j hij
    induction j, hij using Nat.le_induction with
    | base => exact fun _ => ⟨by simp [G], fun l _ => by simp⟩
    | succ j hij ih =>
      intro hj
      obtain ⟨ih1, ih2⟩ := ih (by omega)
      have hSij : S i ≤ S j := hmono hij
      have hcp := hcopy j (by omega)
      have e1 : S (j + 1) = t j + S j := by rw [hS j]; ring
      have e2 : S (j + 1) - S i = t j + (S j - S i) := by rw [hS j]; omega
      refine ⟨?_, fun l hl => ?_⟩
      · rw [e2, G_add (fun i' hi' => hcp i' (by omega)), e1,
          G_add (fun i hi => hcp i (by omega)), ih1]
        rfl
      · rw [e2, show t j + (S j - S i) + l = t j + (S j - S i + l) by ring,
          hcp _ (by omega)]
        exact ih2 l hl
  -- pigeonhole on the states at the times `S k`
  obtain ⟨u, v, huv, heq⟩ := Fintype.exists_ne_map_eq_of_card_lt
    (fun k : Fin (m + 1) => G f w (S k) x) (by simp; omega)
  wlog hlt : (u : ℕ) < v generalizing u v
  · exact this v u huv.symm heq.symm (by
      rcases lt_or_gt_of_ne (Fin.val_ne_of_ne huv) with h | h
      · exact absurd h hlt
      · exact h)
  have hv : (v : ℕ) ≤ m := Nat.lt_succ_iff.1 v.2
  obtain ⟨k1, k2⟩ := key u v hlt.le hv
  refine ⟨u, v, hlt, hv, ?_, ?_, k2⟩
  · have := hS (v - 1)
    rw [show v - 1 + 1 = (v : ℕ) by omega] at this
    have := hmono (show (u : ℕ) ≤ v - 1 by omega)
    omega
  · apply G_injective hf (S u)
    rw [heq, k1]
    rfl

end Copying

/-! ## Residue recurrence -/

/-- **[Oda26] Theorem 50 (residue recurrence).**  Let `b·Q_{n+1} = a·Qₙ + cₙ` with a recurrent
word `c`, and let `M ≥ 2` be prime to `ab`.  Then for all `B` and `L` there is `n ≥ B` with
`Qₙ ≡ Q₀ (mod M)` at which the prefix of length `L` of `c` recurs. -/
@[category research solved, AMS 11 68, ref "Oda26", group "oda26_recurrence"]
theorem residue_recurrence {a b M : ℕ} (hM : 2 ≤ M) (hcop : Nat.Coprime M (a * b))
    {Q c : ℕ → ℤ} (hQ : ∀ n, (b : ℤ) * Q (n + 1) = a * Q n + c n) (hc : IsRecurrent c)
    (B L : ℕ) : ∃ n, B ≤ n ∧ Q n ≡ Q 0 [ZMOD M] ∧ ∀ l, l < L → c (n + l) = c l := by
  have : NeZero M := ⟨by omega⟩
  have hca : Nat.Coprime a M := (Nat.Coprime.coprime_dvd_right (dvd_mul_right a b) hcop).symm
  have hcb : Nat.Coprime b M := (Nat.Coprime.coprime_dvd_right (dvd_mul_left b a) hcop).symm
  set ai : ZMod M := (a : ZMod M)⁻¹
  set bi : ZMod M := (b : ZMod M)⁻¹
  have ha1 : (a : ZMod M) * ai = 1 := ZMod.coe_mul_inv_eq_one a hca
  have hb1 : (b : ZMod M) * bi = 1 := ZMod.coe_mul_inv_eq_one b hcb
  -- the letter actions
  let f : ℤ → ZMod M → ZMod M := fun e x => bi * ((a : ZMod M) * x + e)
  have hf : ∀ e, Function.Injective (f e) := by
    intro e x y hxy
    have h1 : (b : ZMod M) * f e x = (b : ZMod M) * f e y := by rw [hxy]
    simp only [f, ← mul_assoc, hb1, one_mul, add_left_inj] at h1
    calc x = ai * ((a : ZMod M) * x) := by rw [← mul_assoc, mul_comm ai, ha1, one_mul]
      _ = ai * ((a : ZMod M) * y) := by rw [h1]
      _ = y := by rw [← mul_assoc, mul_comm ai, ha1, one_mul]
  have hG : ∀ n, G f c n (Q 0 : ZMod M) = (Q n : ZMod M) := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih =>
      simp only [G, Function.comp, ih, f]
      have := congrArg (Int.cast : ℤ → ZMod M) (hQ n)
      push_cast at this
      rw [← this, ← mul_assoc, mul_comm bi, hb1, one_mul]
  -- the copy times, chosen successively
  let tt : ℕ → ℕ := fun s => Classical.choose (hc (s + L) (max B 1))
  have htt : ∀ s, max B 1 ≤ tt s ∧ ∀ i, i < s + L → c (tt s + i) = c i :=
    fun s => Classical.choose_spec (hc (s + L) (max B 1))
  let S : ℕ → ℕ := fun k => Nat.rec 0 (fun _ s => s + tt s) k
  have hS : ∀ k, S (k + 1) = S k + tt (S k) := fun k => rfl
  obtain ⟨i, j, hij, hjM, ht, hfix, hw⟩ := copying (f := f) (w := c) (X := ZMod M) hf
    (m := M) (L := L) (by simp) (S := S) (t := fun k => tt (S k)) rfl hS
    (fun k _ => by have := (htt (S k)).1; omega) (fun k _ i hi => (htt (S k)).2 i hi) (Q 0)
  refine ⟨S j - S i, ?_, ?_, hw⟩
  · have := (htt (S (j - 1))).1; omega
  · rw [hG] at hfix
    exact (ZMod.intCast_eq_intCast_iff _ _ _).1 hfix

/-! ## The floor orbit -/

section Floor

variable {a b : ℕ} {ξ ν : ℝ}

/-- `Qₙ = ⌊ξ(a/b)ⁿ + ν⌋`; [Oda26]'s floor orbit is `ν = 0`. -/
noncomputable abbrev Qf (a b : ℕ) (ξ ν : ℝ) (n : ℕ) : ℤ := Z32.xInt a b ξ ν n

/-- The carry word `cₙ = b·Q_{n+1} − a·Qₙ`. -/
noncomputable abbrev cf (a b : ℕ) (ξ ν : ℝ) (n : ℕ) : ℤ := Z32.carry a b ξ ν n

@[category API, AMS 11, ref "Oda26", group "oda26_recurrence"]
theorem b_mul_Qf_succ (n : ℕ) : (b : ℤ) * Qf a b ξ ν (n + 1) = a * Qf a b ξ ν n + cf a b ξ ν n := by
  simp only [Qf, cf, Z32.carry]; ring

/-- The growth (7) of [Oda26]: `Qₙ → ∞` for `ξ > 0`, `a > b > 0`. -/
@[category API, AMS 11, ref "Oda26", group "oda26_recurrence"]
theorem tendsto_Qf (hb : 0 < b) (hab : b < a) (hξ : 0 < ξ) :
    Tendsto (Qf a b ξ ν) atTop atTop := by
  have hr : (1 : ℝ) < (a : ℝ) / b := by
    rw [one_lt_div (by exact_mod_cast hb)]; exact_mod_cast hab
  have h1 : Tendsto (fun n : ℕ => ξ * ((a : ℝ) / b) ^ n + ν) atTop atTop :=
    tendsto_atTop_add_const_right _ ν
      (Tendsto.const_mul_atTop hξ (tendsto_pow_atTop_atTop_of_one_lt hr))
  rw [tendsto_atTop]
  intro z
  refine (tendsto_atTop.1 h1 (z : ℝ)).mono fun n hn => ?_
  simp only [Qf, Z32.xInt, Z32.orb]
  exact Int.le_floor.2 (by exact_mod_cast hn)

/-- A proper divisor makes a term composite. -/
theorem not_prime_of_dvd {d x : ℤ} (hd : d ∣ x) (h1 : 1 < d) (h2 : d < x) : ¬ Prime x := by
  intro hp
  have hpn : Nat.Prime x.natAbs := Int.prime_iff_natAbs_prime.1 hp
  have : d.natAbs ∣ x.natAbs := Int.natAbs_dvd_natAbs.2 hd
  rcases hpn.eq_one_or_self_of_dvd _ this with h | h <;> omega

/-- **[Oda26] Theorem 46, second assertion.**  If the carry word has a recurrent tail from `j₀` on,
every later term `Qⱼ > 1` prime to `ab` divides infinitely many later terms. -/
@[category research solved, AMS 11, ref "Oda26", group "oda26_recurrence"]
theorem dvd_frequently_of_recurrent {j₀ : ℕ} (hrec : IsRecurrent fun n => cf a b ξ ν (j₀ + n))
    {j : ℕ} (hj : j₀ ≤ j) (hQ : 1 < Qf a b ξ ν j) (hcop : Int.gcd (Qf a b ξ ν j) (a * b) = 1) :
    ∃ᶠ n in atTop, Qf a b ξ ν j ∣ Qf a b ξ ν n := by
  set M := (Qf a b ξ ν j).toNat
  have hMQ : (M : ℤ) = Qf a b ξ ν j := Int.toNat_of_nonneg (by omega)
  have hM : 2 ≤ M := by omega
  have hcopM : Nat.Coprime M (a * b) := by
    have : Int.gcd (M : ℤ) ((a * b : ℕ) : ℤ) = 1 := by rw [hMQ]; exact_mod_cast hcop
    rwa [Int.gcd_natCast_natCast] at this
  have hrecj : IsRecurrent fun n => cf a b ξ ν (j + n) := by
    have := hrec.tail (j - j₀)
    simpa [show ∀ n, j₀ + (j - j₀ + n) = j + n from fun n => by omega] using this
  rw [Filter.frequently_atTop]
  intro N
  obtain ⟨n, hn, hmod, -⟩ := residue_recurrence (a := a) (b := b) hM hcopM
    (Q := fun n => Qf a b ξ ν (j + n)) (c := fun n => cf a b ξ ν (j + n))
    (fun n => by rw [show j + (n + 1) = (j + n) + 1 by ring]; exact b_mul_Qf_succ _) hrecj N 0
  refine ⟨j + n, by omega, ?_⟩
  have h0 : Qf a b ξ ν j ≡ 0 [ZMOD M] := by rw [hMQ]; exact Int.emod_self.trans (Int.zero_emod _).symm
  have := (hmod.trans h0)
  rw [← hMQ]
  exact (Int.modEq_zero_iff_dvd).1 (by simpa using this)

/-- **[Oda26] Theorem 46.**  If the carry word of `⌊ξ(a/b)ⁿ⌋` has a recurrent tail, the sequence
has infinitely many composite terms. -/
@[category research solved, AMS 11, ref "Oda26", group "oda26_recurrence"]
theorem composite_frequently_of_recurrent (hb : 2 ≤ b) (hab : b < a) (hξ : 0 < ξ) {j₀ : ℕ}
    (hrec : IsRecurrent fun n => cf a b ξ ν (j₀ + n)) :
    ∃ᶠ n in atTop, 1 < Qf a b ξ ν n ∧ ¬ Prime (Qf a b ξ ν n) := by
  have hT := tendsto_Qf (a := a) (b := b) (ξ := ξ) (ν := ν) (by omega) hab hξ
  by_cases hcase : ∃ j, j₀ ≤ j ∧ 1 < Qf a b ξ ν j ∧ Int.gcd (Qf a b ξ ν j) (a * b) = 1
  · -- Case 1: a term prime to `ab` divides infinitely many later terms
    obtain ⟨j, hj, hQ, hcop⟩ := hcase
    have hev : ∀ᶠ n in atTop, Qf a b ξ ν j < Qf a b ξ ν n := hT.eventually_gt_atTop _
    refine ((dvd_frequently_of_recurrent hrec hj hQ hcop).and_eventually hev).mono ?_
    rintro n ⟨hd, hlt⟩
    exact ⟨by omega, not_prime_of_dvd hd hQ hlt⟩
  · -- Case 2: eventually every term shares a factor with `ab`
    push Not at hcase
    have hev : ∀ᶠ n in atTop, j₀ ≤ n ∧ ((a * b : ℕ) : ℤ) < Qf a b ξ ν n :=
      (eventually_ge_atTop j₀).and (hT.eventually_gt_atTop _)
    refine (hev.mono fun n ⟨hn, hgt⟩ => ?_).frequently
    have hab0 : (0 : ℤ) < ((a * b : ℕ) : ℤ) := by
      have : 0 < a * b := Nat.mul_pos (by omega) (by omega); exact_mod_cast this
    have h1 : 1 < Qf a b ξ ν n := by omega
    refine ⟨h1, ?_⟩
    have hg := hcase n hn h1
    set g := Int.gcd (Qf a b ξ ν n) (a * b)
    have hgd : (g : ℤ) ∣ Qf a b ξ ν n := Int.gcd_dvd_left _ _
    have hgle : (g : ℤ) ≤ ((a * b : ℕ) : ℤ) := by
      have : g ∣ a * b := by
        have := Int.gcd_dvd_right (Qf a b ξ ν n) ((a * b : ℕ) : ℤ)
        exact_mod_cast this
      exact_mod_cast Nat.le_of_dvd (Nat.mul_pos (by omega) (by omega)) this
    have hg0 : g ≠ 0 := by
      intro h0; rw [Int.gcd_eq_zero_iff] at h0; omega
    exact not_prime_of_dvd hgd (by omega) (by omega)

/-- **[Oda26] Corollary 51 (refutation form).**  If all terms from some index on are prime, the
carry word has no recurrent tail. -/
@[category research solved, AMS 11, ref "Oda26", group "oda26_recurrence"]
theorem not_recurrent_of_eventually_prime (hb : 2 ≤ b) (hab : b < a) (hξ : 0 < ξ) {n₀ : ℕ}
    (hprime : ∀ n, n₀ ≤ n → Prime (Qf a b ξ ν n)) (j₀ : ℕ) :
    ¬ IsRecurrent fun n => cf a b ξ ν (j₀ + n) := by
  intro hrec
  obtain ⟨n, hn, -, hnp⟩ := (composite_frequently_of_recurrent hb hab hξ hrec).forall_exists_of_atTop n₀
  exact hnp (hprime n hn)

end Floor

end Oda
