/-- **X-238.**  No `ξ ≠ 0` has every `{ξ(3/2)ⁿ}` in `[0, 119/500) ∪ [381/500, 1)`, i.e. no
`ξ ≠ 0` has `‖ξ(3/2)ⁿ‖ < 0.238` for every `n`.  This **supersedes `Z32.two_cell_fifth_empty`**
(the same statement at `1/5 = 0.2`), and closes all but `1.7·10⁻⁵` of the gap to the printed
`0.238117…` of [Dub06JNT] (Bugeaud, Cambridge Tract 193, Theorem 3.14). -/
@[category research solved, AMS 11 37, ref "Dub06JNT" "Dub09AA" "Dub10", group "z32_block_cert"]
theorem two_cell_238_empty {ξ : ℝ} (hξ : ξ ≠ 0) :
    ¬ ∀ n : ℕ, Int.fract (ξ * ((3 : ℝ) / 2) ^ n) ∈
      Set.Ico (0 : ℝ) (119 / 500) ∪ Set.Ico (381 / 500 : ℝ) 1 := by
  intro h
  refine not_confined_base certTwoCell238_ok (3 / 2) (by norm_num [certTwoCell238]) hξ
    fun n => ?_
  rcases h n with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · refine ⟨(0, 520506), by simp [certTwoCell238], ?_, ?_⟩ <;>
      simp only [certTwoCell238, rleR] <;> push_cast <;> linarith
  · refine ⟨(1666494, 2187000), by simp [certTwoCell238], ?_, ?_⟩ <;>
      simp only [certTwoCell238, rleR] <;> push_cast <;> linarith

