import DubC2.Branch

/-!
# Branching witnesses on the frontier cells (generated)

Generated by `DubC2/xfrontier.py --emit-branch` from `DubC2/data/transform/xh/xb_frontier.jsonl`:
for each branching follower automaton of note §11, two loops at one state, raised to residue-fixing
powers, and the state's interval.  These cells are also killed by horseshoes (`HorseshoeFrontier.lean`);
the instances show that `DubC2.Gen.branchOK` is met by the generator's data.  Statements about the
certificate method, not about the orbits.
-/

namespace DubC2.Gen.BranchFrontier

open DubC2.Gen

