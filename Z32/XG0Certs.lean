@[category API, AMS 11 37, ref "KP18" "Mah68", group "z32_phi_model"]
theorem horseKP_ok : horseKP.ok = true := by decide

@[category API, AMS 11 37, ref "KP18", group "z32_phi_model"]
theorem horseKP_uSet :
    horseKP.uSet = Set.Ico (0 : ℝ) (1 / 6) ∪ Set.Ico (1 / 3 : ℝ) (2 / 3) := by
  ext y
  constructor
  · rintro ⟨I, hI, h1, h2⟩
    simp only [horseKP, List.mem_cons, List.not_mem_nil, or_false] at hI
    rcases hI with rfl | rfl
    · simp only [horseKP, rleR] at h1 h2
      push_cast at h1 h2
      exact Or.inl ⟨by linarith, by linarith⟩
    · simp only [horseKP, rleR] at h1 h2
      push_cast at h1 h2
      exact Or.inr ⟨by linarith, by linarith⟩
  · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)
    · refine ⟨(0, 6305), by simp [horseKP], ?_, ?_⟩
      · simp only [horseKP]; push_cast; linarith
      · simp only [horseKP, rleR]; push_cast; linarith
    · refine ⟨(12610, 25220), by simp [horseKP], ?_, ?_⟩
      · simp only [horseKP]; push_cast; linarith
      · simp only [horseKP, rleR]; push_cast; linarith

/-- **The set to which [KP18] Corollary 18 reduces Mahler's problem carries model entropy at
least `(log 21)/8 = 0.38063…`.**  Its hold set is the golden-mean shift, of entropy
`log((1+√5)/2) = 0.48121…`, so this is `79 %` of the truth; what matters is that it is positive.
By `Z32.not_cert_and_horse` no block certificate with `strata = []` exists for this union, and by
Theorem B of `Z32/README.md` §M7 — the hold set carries Lucas-many periodic points, hence
infinitely many periodic orbits — none exists with a stratification either, at any product level.
So **no certificate of this family can prove Mahler's conjecture**, and the obstruction is not a
budget. -/
@[category research solved, AMS 11 37, ref "KP18" "Mah68" "Dub09AA", group "z32_phi_model"]
theorem log_twentyone_div_eight_le_phiModel_kp :
    Real.log 21 / 8 ≤ phiModel 3 2 (Set.Ico (0 : ℝ) (1 / 6) ∪ Set.Ico (1 / 3 : ℝ) (2 / 3)) := by
  have h := Horse.le_phiModel horseKP_ok
  rw [horseKP_uSet] at h
  refine le_trans (le_of_eq ?_) h
  have hw : ((horseKP.words.length : ℕ) : ℝ) = 21 := by norm_num [horseKP]
  have hl : ((horseKP.len : ℕ) : ℝ) = 8 := by norm_num [horseKP, Horse.len]
  rw [hw, hl]

